{
  "name": "tenir-site",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4731",
    "build": "node scripts/check-workbench-release.mjs && astro build && node scripts/finalize-html.mjs && node scripts/generate-sitemap.mjs && node scripts/check-workbench-release.mjs --dist",
    "preview": "astro preview --host 127.0.0.1 --port 4731",
    "check:links": "node scripts/check-links.mjs",
    "check:assets": "node --experimental-strip-types scripts/check-asset-registry.mjs",
    "check:assets:unit": "node --experimental-strip-types scripts/check-asset-registry.mjs --self-test",
    "check:assets:remote": "node --experimental-strip-types scripts/check-asset-registry.mjs --remote",
    "check:process-roles": "node scripts/check-process-roles.mjs",
    "check:workbench-release": "node scripts/check-workbench-release.mjs",
    "check:workbench-release:unit": "node scripts/check-workbench-release.mjs --self-test"
  },
  "dependencies": {
    "astro": "^7.4.1"
  }
}
