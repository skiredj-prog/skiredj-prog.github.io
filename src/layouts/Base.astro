---
import '../styles/fonts.css';
import '../styles/site.css';
import '../styles/experience.css';
import '../styles/journeys.css';
import '../styles/responsibility.css';
import '../styles/sector-map.css';
import '../styles/execution-video.css';
import '../styles/process-roles.css';
import '../styles/shell.css';
import MarketingHome from '../components/MarketingHome.astro';
import ContactBrief from '../components/ContactBrief.astro';
import SiteHeader from '../components/SiteHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { journeys, journeyHref } from '../data/journeys';
import { portfolioContactHref } from '../data/contact';
import { alternate, copy, url, type Locale } from '../data/site';
import { footerGroups, sectionItem, sectionOf } from '../data/navigation';
interface Props { locale: Locale; slug: string; title: string; description: string; kicker: string; lede: string; sources: string; documentTitle?: string; }
const { locale, slug, title, description, kicker, lede, sources, documentTitle } = Astro.props;
const fr=locale==='fr', t=copy[locale];
const home=slug==='';
const isCredibility=slug==='credibilite'||slug==='credibility';
const isPathway=slug==='parcours-ia'||slug==='ai-readiness';
const isJourney=slug.startsWith('parcours/')||slug.startsWith('start/');
const isBusiness=slug==='parcours/activite'||slug==='start/business';
const isPortfolio=slug.startsWith('portfolio/');
const other=slug==='404'?(fr?'/en/':'/'):alternate(locale,slug);
const here=slug==='404'?'/':fr?(slug?`/${slug}/`:'/'):`/en/${slug?`${slug}/`:''}`;
const canonical=new URL(url(here),Astro.site);
const path=(f:string,e:string=f)=>url(fr?`/${f}/`:`/en/${e}/`);
const selectedJourney=journeys[locale].find(j=>slug===(fr?`parcours/${j.slug}`:`start/${j.slug}`));
const readerContact=home?path('parcours-ia','ai-readiness'):isPortfolio?portfolioContactHref(locale,slug.split('/')[1]):path('contact')+(selectedJourney?`?situation=${selectedJourney.id}`:'');
const pageKinds: Record<string, string> = {
  offre: fr?'Service':'Service', offer:'Service',
  'diagnostic-execution': fr?'Diagnostic spécialisé':'Specialized diagnostic',
  'credibilite': fr?'Parcours Crédibilité':'Credibility Journey', 'credibility': fr?'Parcours Crédibilité':'Credibility Journey',
  'produits-et-services': 'Service · REG', 'products-and-services': 'Service · REG',
  'offre/exemple': fr?'Exemple simulé':'Simulated example', 'offer/example':'Simulated example',
  'architecture/demo': fr?'Démonstration':'Demo', 'architecture/interactive': fr?'Démonstration interactive':'Interactive demo',
  'architecture/drawing': fr?'Document illustratif':'Illustrative document',
  concepts: fr?'Cadre et recherche':'Framework and research', standard: fr?'Standard proposé':'Proposed standard',
  depots: fr?'Sources logicielles':'Software sources', repositories:'Software sources',
};
// Section crumb between "Home" and the page, unless the page is the section's own landing page.
const sectionLink=sectionItem(locale,sectionOf(slug));
const crumb=sectionLink&&sectionLink.slug!==slug?sectionLink:undefined;
// Pages whose own flow already ends the reading: journeys, the 404 and the two step-by-step replays.
const ownEnding=slug==='404'||isJourney||['rejouer','replay','demonstrations/journal','demos/log'].includes(slug);
const heroWidth=isPortfolio?'page-hero--wide':slug==='contact'?'page-hero--narrow':isBusiness?'page-hero--business':undefined;
const groups=footerGroups[locale];
const mainTitle=documentTitle??(home?(fr?'TENIR Labs — L’IA agit. Vous gardez la main.':'TENIR Labs — AI takes action. You stay in control.'):`${title} — TENIR`);
const mainDescription=home?(fr?'Confiez des tâches à l’IA, pas les clés de votre entreprise. TENIR Labs aide à encadrer les actions des agents IA, anticiper les risques et reprendre la main lorsque le résultat est incertain.':'Give AI the work, not the keys to your business. TENIR Labs helps you govern AI-agent actions, anticipate risk and respond when the outcome is uncertain.'):description;
---
<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{mainTitle}</title><meta name="description" content={mainDescription} />
    <link rel="canonical" href={canonical} /><link rel="alternate" hreflang={locale} href={canonical} /><link rel="alternate" hreflang={fr?'en':'fr'} href={new URL(url(other),Astro.site)} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#071629" />
    <meta property="og:title" content={mainTitle} /><meta property="og:description" content={mainDescription} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} /><meta property="og:locale" content={fr?'fr_FR':'en_GB'} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { var saved=localStorage.getItem('tenir-theme'); document.documentElement.dataset.theme=(saved==='dark'||saved==='light')?saved:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'); } catch(e) {}
    </script>
  </head>
  <body class:list={[home&&'marketing-page',isCredibility&&'credibility-page',isPathway&&'pathway-page']}>
    <a class="skip" href="#content">{t.skip}</a>
    <SiteHeader locale={locale} slug={slug} here={here} other={other} />
    {isCredibility ? <main id="content" class="home-main" tabindex="-1"><slot/></main>
    : home ? <main id="content" class="home-main" tabindex="-1"><MarketingHome locale={locale}/><details class="reading-note"><summary>{fr?'Statut, sources et limites de cette présentation':'Status, sources and limits of this presentation'}</summary><div class="prose"><p class="sources">{t.sources} : {sources}</p><slot /></div></details></main>
    : isPathway ? <main id="content" class="pathway-main" tabindex="-1"><slot/></main>
    : <main id="content" class="page-main" tabindex="-1">
        <header class:list={['page-hero',heroWidth]}>
          <div class="page-hero-inner">
            <nav class="breadcrumb" aria-label={fr?'Fil d’Ariane':'Breadcrumb'}><a href={url(fr?'/':'/en/')}>{fr?'Accueil':'Home'}</a><span aria-hidden="true">/</span>{crumb&&<><a href={url(crumb.href)}>{crumb.label}</a><span aria-hidden="true">/</span></>}<span aria-current="page">{title}</span></nav>
            <p class="kicker">{pageKinds[slug]&&<span>{pageKinds[slug]} · </span>}{kicker}</p>
            <h1>{title}</h1>
            {!isPortfolio&&<><p class="lede">{lede}</p>{slug!=='contact'&&<details class="source-disclosure"><summary>{fr?'Sources et contexte de lecture':'Sources and reading context'}</summary><p class="sources">{sources}</p><p>{t.status} <a href={path('statut','status')}>{fr?'Lire le statut détaillé':'Read the detailed status'} →</a></p></details>}</>}
          </div>
        </header>
        <div class:list={['doc',slug==='contact'&&'contact-page',isBusiness&&'business-page',isPortfolio&&'portfolio-page']}>
          <article>
            {slug==='contact'&&<ContactBrief locale={locale}/>}
            {(slug==='offre'||slug==='offer'||slug==='produits-et-services'||slug==='products-and-services')&&<div class="offer-summary"><div><span class="role">{fr?'Le point de départ':'The starting point'}</span><strong>{fr?'Un cas précis. Une fiche sourcée. Une suite à décider.':'One precise case. A sourced sheet. A next step to decide.'}</strong><p>{fr?'Cadrage proposé : 30 min · forfait sur devis · format à confirmer':'Proposed scoping: 30 min · fixed quote · format to confirm'}</p></div><a class="btn btn-primary" href={path('contact')}>{fr?'Préparer le premier échange':'Prepare the first conversation'} →</a></div>}
            {slug!=='contact'&&<details class="mobile-toc" data-mobile-toc hidden><summary>{t.toc}</summary><ol></ol></details>}
            {isBusiness||isPortfolio?<slot />:slug==='contact'?<details class="contact-references"><summary>{fr?'Références de l’auteur et citations':'Author references and citations'}</summary><div class="prose"><slot /></div></details>:<div class="prose"><slot /></div>}
          </article>
          {slug!=='contact'&&<aside class="toc" id="toc" hidden><p>{t.toc}</p><ol></ol><a class="toc-help" href={readerContact}>{fr?'Une question en lisant ?':'A question while reading?'}<strong>{fr?'Écrire à Abdelaziz':'Write to Abdelaziz'} ↗</strong></a><a class="toc-help" href={url(journeyHref(locale,journeys[locale][0]))}>{fr?'Revenir à une explication simple':'Return to a simple explanation'} →</a></aside>}
        </div>
        {!ownEnding&&<CtaBand locale={locale} slug={slug} contactHref={readerContact}/>}
      </main>}
    <footer class="site-footer"><div class="footer-top"><div class="footer-brand"><a class="brand" href={url(fr?'/':'/en/')}><span class="brand-name">TENIR <span class="brand-labs">LABS</span></span><span class="visually-hidden">{fr?' — accueil':' — home'}</span></a><p>{fr?'Des actions encadrées.\nDes décisions éclairées.':'Bounded actions.\nInformed decisions.'}</p><a href="mailto:skiredj@tenirlabs.cc">skiredj@tenirlabs.cc ↗</a><a class="footer-prototype" href="https://mobile.tenirlabs.cc/discover">{fr?'Explorer le prototype mobile':'Explore the mobile prototype'} ↗</a></div><nav class="footer-links" aria-label={fr?'Plan du site':'Site map'}>{groups.map(group=><div><h2>{group.label}</h2>{group.links.map(link=><a href={url(link.href)}>{link.label}</a>)}</div>)}</nav></div><div class="footer-bottom"><p>© 2026 Abdelaziz Skiredj · TENIR Labs</p><p>{fr?'Cadre en développement · démonstrations bornées · aucune certification':'Framework in development · bounded demonstrations · no certification'}</p><a href={path('statut','status')}>{fr?'Statut et limites':'Status and limits'} ↗</a></div></footer>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
