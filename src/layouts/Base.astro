---
import "../styles/fonts.css";
import "../styles/site.css";
import { alternate, copy, navContact, navGroups, navProducts, url, type Locale } from "../data/site";

interface Props {
  locale: Locale;
  slug: string;
  title: string;
  description: string;
  kicker: string;
  lede: string;
  sources: string;
}

const { locale, slug, title, description, kicker, lede, sources } = Astro.props;
const t = copy[locale];
const groups = navGroups[locale];
const products = navProducts[locale];
const contact = navContact[locale];
const home = slug === "";
const other = slug === "404" ? (locale === "fr" ? "/en/" : "/") : alternate(locale, slug);
const here = slug === "404" ? "/" : locale === "fr" ? (slug ? `/${slug}/` : "/") : `/en/${slug ? `${slug}/` : ""}`;
const canonical = new URL(url(here), Astro.site);
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === "TENIR" ? "TENIR" : `${title} — TENIR`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#16141c" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("tenir-theme");
          var theme = stored || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content">{t.skip}</a>
    {
      !home && (
        <div class="banner">
          <p>{t.status}</p>
        </div>
      )
    }
    <header class="site-header">
      <div class="header-row">
        <a class="brand" href={url(locale === "fr" ? "/" : "/en/")}>
          <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="1" y="1" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.2"></rect>
            <path d="M10 8h8.5M14.2 8v16M10 24h8.5" fill="none" stroke="currentColor" stroke-width="1.4"></path>
          </svg>
          <span>
            <span class="brand-name">TENIR</span>
            <span class="brand-sub">{locale === "fr" ? "Diagnostic et gouvernance" : "Diagnostic and governance"}</span>
          </span>
        </a>
        <div class="tools">
          <nav class="lang" aria-label={t.lang}>
            <a href={url(locale === "fr" ? here : other)} lang="fr" aria-current={locale === "fr" && slug !== "404" ? "true" : undefined}>FR</a>
            <a href={url(locale === "en" ? here : other)} lang="en" aria-current={locale === "en" && slug !== "404" ? "true" : undefined}>EN</a>
          </nav>
          <button class="theme" type="button" data-theme-toggle aria-pressed="false">
            <span class="label-light">{t.themeToDark}</span>
            <span class="label-dark">{t.themeToLight}</span>
          </button>
          <button class="menu-toggle" type="button" data-mobile-menu-toggle aria-controls="site-navigation"
            aria-expanded="false" aria-label={locale === "fr" ? "Afficher le menu de navigation" : "Show navigation menu"}>Menu</button>
        </div>
      </div>
      <nav class="site-nav" id="site-navigation" aria-label={t.nav}>
        {
          groups.map((group) => {
            const current = group.links.some((link) => link.slug === slug);
            return (
              <details class:list={["nav-group", current && "is-current"]}>
                <summary>{group.label}</summary>
                <div class="nav-menu">
                  {group.links.map((link) => (
                    <a href={url(link.href)} aria-current={link.slug === slug ? "page" : undefined}>
                      {link.label}
                    </a>
                  ))}
                </div>
              </details>
            );
          })
        }
        <a class="nav-end" href={url(products.href)} aria-current={products.slug === slug ? "page" : undefined}>
          {products.label}
        </a>
        <a href={url(contact.href)} aria-current={contact.slug === slug ? "page" : undefined}>
          {contact.label}
        </a>
      </nav>
    </header>
    <main id="content" class:list={["doc", home && "home"]}>
      <article>
        {
          home ? (
            <header class="hero">
              <p class="eyebrow">{t.eyebrow}</p>
              <h1>{title}</h1>
              <p class="headline">{t.headline}</p>
              <p class="hold-mark" aria-hidden="true">
                <span class="hold-receipt">{locale === "fr" ? "reçu" : "receipt"}</span>
                <span class="hold-break"></span>
                <span class="hold-word">HOLD</span>
              </p>
              <div class="actions">
                <a class="btn btn-primary" href={t.cadrerHref}>{t.cadrer}</a>
              </div>
              <p class="sources">{t.sources} : {sources}</p>
            </header>
          ) : (
            <header class="doc-head">
              <p class="kicker">{kicker}</p>
              <h1>{title}</h1>
              <p class="lede">{lede}</p>
              <p class="sources">{t.sources} : {sources}</p>
            </header>
          )
        }
        <div class="prose">
          <slot />
        </div>
      </article>
      <aside class="toc" id="toc" hidden>
        <p>{t.toc}</p>
        <ol></ol>
      </aside>
    </main>
    <footer class="site-footer">
      <div class="inner">
        <p>{t.footerNote}</p>
        <p>
          <a href={url(locale === "fr" ? "/publications/" : "/en/publications/")}>Publications</a>
          ·
          <a href={url(locale === "fr" ? "/contribuer/" : "/en/contribute/")}>{locale === "fr" ? "Contribuer" : "Contribute"}</a>
          ·
          <a href={url(products.href)}>{products.label}</a>
          ·
          <a href={url(contact.href)}>Contact</a>
          ·
          <a href="https://github.com/skiredj-prog/tenir_governance">GitHub</a>
          ·
          <a href="mailto:skiredj@tenirlabs.cc">skiredj@tenirlabs.cc</a>
        </p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var button = document.querySelector("[data-theme-toggle]");
        function sync() {
          if (!button) return;
          button.setAttribute("aria-pressed", root.dataset.theme === "dark" ? "true" : "false");
        }
        sync();
        if (button) {
          button.addEventListener("click", function () {
            var next = root.dataset.theme === "dark" ? "light" : "dark";
            root.dataset.theme = next;
            try { localStorage.setItem("tenir-theme", next); } catch (e) {}
            sync();
          });
        }
        document.querySelectorAll("[data-scenario]").forEach(function (root) {
          var panels = Array.prototype.slice.call(root.querySelectorAll("[data-panel]"));
          var tabs = Array.prototype.slice.call(root.querySelectorAll("[data-step]"));
          var prev = root.querySelector("[data-prev]");
          var next = root.querySelector("[data-next]");
          if (!panels.length || panels.length !== tabs.length || !prev || !next) return;
          var index = 0;
          function show(i) {
            if (i < 0 || i >= panels.length) return;
            index = i;
            root.setAttribute("data-ready", "true");
            panels.forEach(function (panel, n) {
              panel.hidden = n !== index;
            });
            tabs.forEach(function (tab, n) {
              var on = n === index;
              tab.setAttribute("aria-selected", on ? "true" : "false");
              tab.tabIndex = on ? 0 : -1;
              if (on) tab.setAttribute("aria-current", "step");
              else tab.removeAttribute("aria-current");
            });
            prev.disabled = index === 0;
            next.disabled = index === panels.length - 1;
          }
          function move(i) {
            show(i);
            tabs[index].focus();
          }
          tabs.forEach(function (tab, n) {
            tab.setAttribute("role", "tab");
            tab.addEventListener("click", function () { show(n); });
            tab.addEventListener("keydown", function (event) {
              var key = event.key;
              if (key === "ArrowRight" || key === "ArrowDown") {
                event.preventDefault();
                move(Math.min(index + 1, panels.length - 1));
              } else if (key === "ArrowLeft" || key === "ArrowUp") {
                event.preventDefault();
                move(Math.max(index - 1, 0));
              } else if (key === "Home") {
                event.preventDefault();
                move(0);
              } else if (key === "End") {
                event.preventDefault();
                move(panels.length - 1);
              }
            });
          });
          prev.addEventListener("click", function () { show(index - 1); });
          next.addEventListener("click", function () { show(index + 1); });
          show(0);
        });
        var prose = document.querySelector(".prose");
        var toc = document.getElementById("toc");
        if (!prose || !toc) return;
        var heads = prose.querySelectorAll("h2");
        if (heads.length < 2) return;
        var list = toc.querySelector("ol");
        heads.forEach(function (h) {
          if (!h.id) h.id = h.textContent.toLowerCase().replace(/[^a-z0-9]+/gi, "-").replace(/^-|-$/g, "");
          var li = document.createElement("li");
          var a = document.createElement("a");
          a.href = "#" + h.id;
          a.textContent = h.textContent;
          li.appendChild(a);
          list.appendChild(li);
        });
        toc.hidden = false;
      })();
      (function () {
        var nav = document.querySelector(".site-nav");
        if (!nav) return;
        var groups = nav.querySelectorAll("details");
        var toggle = document.querySelector("[data-mobile-menu-toggle]");

        function setMenu(open) {
          if (!toggle) return;
          nav.toggleAttribute("data-open", open);
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
          toggle.setAttribute("aria-label", document.documentElement.lang === "fr"
            ? (open ? "Masquer le menu de navigation" : "Afficher le menu de navigation")
            : (open ? "Hide navigation menu" : "Show navigation menu"));
          if (!open) groups.forEach(function (group) { group.open = false; });
        }
        if (toggle) {
          // Keep navigation visible for non-JS users.
          document.documentElement.classList.add("nav-enhanced");
          toggle.addEventListener("click", function () { setMenu(!nav.hasAttribute("data-open")); });
          nav.querySelectorAll("a").forEach(function (link) {
            link.addEventListener("click", function () { setMenu(false); });
          });
          var mobile = window.matchMedia("(max-width: 960px)");
          if (mobile.addEventListener) mobile.addEventListener("change", function () { setMenu(false); });
        }
        groups.forEach(function (group) {
          group.addEventListener("toggle", function () {
            if (!group.open) return;
            groups.forEach(function (other) {
              if (other !== group) other.open = false;
            });
          });
        });
        document.addEventListener("keydown", function (event) {
          if (event.key !== "Escape") return;
          var wasOpen = nav.hasAttribute("data-open");
          groups.forEach(function (group) { group.open = false; });
          setMenu(false);
          if (wasOpen && toggle) toggle.focus();
        });
        document.addEventListener("click", function (event) {
          if (nav.contains(event.target) || (toggle && toggle.contains(event.target))) return;
          groups.forEach(function (group) { group.open = false; });
          if (window.matchMedia("(max-width: 960px)").matches) setMenu(false);
        });
      })();
    </script>
  </body>
</html>
