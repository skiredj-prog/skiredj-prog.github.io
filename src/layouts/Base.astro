---
import '../styles/fonts.css';
import '../styles/site.css';
import '../styles/experience.css';
import Home from '../components/Home.astro';
import ContactBrief from '../components/ContactBrief.astro';
import { alternate, copy, navContact, navGroups, navProducts, url, type Locale } from '../data/site';
interface Props { locale: Locale; slug: string; title: string; description: string; kicker: string; lede: string; sources: string; }
const { locale, slug, title, description, kicker, lede, sources } = Astro.props;
const fr=locale==='fr', t=copy[locale], groups=navGroups[locale], products=navProducts[locale], contact=navContact[locale];
const home=slug==='';
const other=slug==='404'?(fr?'/en/':'/'):alternate(locale,slug);
const here=slug==='404'?'/':fr?(slug?`/${slug}/`:'/'):`/en/${slug?`${slug}/`:''}`;
const canonical=new URL(url(here),Astro.site);
const path=(f:string,e:string=f)=>url(fr?`/${f}/`:`/en/${e}/`);
const demo=groups[2];
const resources=[...groups[3].links,...groups[4].links,...groups[0].links.filter(x=>x.slug!=='concepts'),groups[1].links[0],groups[1].links[4],{slug:fr?'contribuer':'contribute',href:fr?'/contribuer/':'/en/contribute/',label:fr?'Contribuer':'Contribute'}];
const footerGroups=[...groups,{id:'services',label:fr?'Accompagnement':'Services',links:[products,{slug:fr?'offre':'offer',href:fr?'/offre/':'/en/offer/',label:'Diagnostic'},contact]}];
const mainTitle=home?(fr?'TENIR — Laissez vos agents agir. Gardez la main.':'TENIR — Let your agents act. Stay in control.'):`${title} — TENIR`;
const mainDescription=home?(fr?'Comprendre les contrôles des actions d’agents, explorer un prototype de délégation et cadrer un diagnostic sourcé avec TENIR.':'Understand controls for agent actions, explore a delegation prototype and scope a sourced diagnostic with TENIR.'):description;
---
<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{mainTitle}</title><meta name="description" content={mainDescription} />
    <link rel="canonical" href={canonical} /><link rel="alternate" hreflang={locale} href={canonical} /><link rel="alternate" hreflang={fr?'en':'fr'} href={new URL(url(other),Astro.site)} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#f6f7f2" />
    <meta property="og:title" content={mainTitle} /><meta property="og:description" content={mainDescription} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} /><meta property="og:locale" content={fr?'fr_FR':'en_GB'} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { var saved=localStorage.getItem('tenir-theme'); document.documentElement.dataset.theme=(saved==='dark'||saved==='light')?saved:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'); } catch(e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">{t.skip}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={url(fr?'/':'/en/')} aria-label={fr?'TENIR — accueil':'TENIR — home'}><svg class="mark" viewBox="0 0 32 32" aria-hidden="true"><rect x="1" y="1" width="30" height="30" rx="4" fill="none" stroke="currentColor" stroke-width="1.2"></rect><path d="M10 8h12M16 8v16M10 24h12" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg><span class="brand-name">TENIR<span class="brand-labs">LABS</span></span></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" data-menu-toggle><span>Menu</span><span class="menu-symbol" aria-hidden="true">☰</span></button>
        <nav class="site-nav" id="main-navigation" aria-label={t.nav}>
          <a href={path('concepts')} aria-current={slug==='concepts'?'page':undefined}>{fr?'Comprendre':'Understand'}</a>
          <details class="nav-group"><summary>{fr?'Démonstrations':'Demonstrations'}</summary><div class="nav-menu"><a href="https://mobile.tenirlabs.cc/discover"><strong>{fr?'Prototype mobile':'Mobile prototype'}</strong><small>{fr?'Déléguer une tâche · simulation':'Delegate a task · simulation'}</small></a>{demo.links.map(link=><a href={url(link.href)} aria-current={link.slug===slug?'page':undefined}>{link.label}</a>)}</div></details>
          <details class:list={['nav-group',resources.some(x=>x.slug===slug)&&'is-current']}><summary>{fr?'Ressources':'Resources'}</summary><div class="nav-menu resource-menu">{resources.map(link=><a href={url(link.href)} aria-current={link.slug===slug?'page':undefined}>{link.label}</a>)}</div></details>
          <a href={path('offre','offer')} aria-current={slug===(fr?'offre':'offer')?'page':undefined}>Diagnostic</a>
          <div class="nav-mobile-tools"><a href={url(other)} lang={fr?'en':'fr'}>{fr?'Read in English':'Lire en français'}</a></div>
        </nav>
        <div class="tools"><nav class="lang" aria-label={t.lang}><a href={url(fr?here:other)} lang="fr" aria-current={fr&&slug!=='404'?'true':undefined}>FR</a><a href={url(fr?other:here)} lang="en" aria-current={!fr&&slug!=='404'?'true':undefined}>EN</a></nav><button class="theme" type="button" data-theme-toggle aria-pressed="false" aria-label={t.themeToDark} data-label-dark={t.themeToDark} data-label-light={t.themeToLight}><span class="label-light" aria-hidden="true">◐</span><span class="label-dark" aria-hidden="true">◑</span></button><a class="btn btn-primary header-cta" href={path('contact')}>{fr?'Parlons de votre cas':'Let’s discuss your case'} <span aria-hidden="true">↗</span></a></div>
      </div>
    </header>
    <main id="content" class:list={[home?'home-main':'doc',slug==='contact'&&'contact-page']} tabindex="-1">
      {home ? <><Home locale={locale}/><details class="reading-note"><summary>{fr?'Statut, sources et limites de cette présentation':'Status, sources and limits of this presentation'}</summary><div class="prose"><p class="sources">{t.sources} : {sources}</p><slot /></div></details></> : <>
        <article>
          <nav class="breadcrumb" aria-label={fr?'Fil d’Ariane':'Breadcrumb'}><a href={url(fr?'/':'/en/')}>{fr?'Accueil':'Home'}</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
          <header class="doc-head"><p class="kicker">{kicker}</p><h1>{title}</h1><p class="lede">{lede}</p><details class="source-disclosure"><summary>{fr?'Sources et contexte de lecture':'Sources and reading context'}</summary><p class="sources">{sources}</p><p>{t.status} <a href={path('statut','status')}>{fr?'Lire le statut détaillé':'Read the detailed status'} →</a></p></details></header>
          {slug==='contact'&&<ContactBrief locale={locale}/>}
          {(slug==='offre'||slug==='offer'||slug==='produits-et-services'||slug==='products-and-services')&&<div class="offer-summary"><div><span class="role">{fr?'Le point de départ':'The starting point'}</span><strong>{fr?'Un cas précis. Une fiche sourcée. Une suite à décider.':'One precise case. A sourced sheet. A next step to decide.'}</strong><p>{fr?'Cadrage proposé : 30 min · forfait sur devis · format à confirmer':'Proposed scoping: 30 min · fixed quote · format to confirm'}</p></div><a class="btn btn-primary" href={path('contact')}>{fr?'Préparer le premier échange':'Prepare the first conversation'} →</a></div>}
          <details class="mobile-toc" data-mobile-toc hidden><summary>{t.toc}</summary><ol></ol></details>
          <div class="prose"><slot /></div>
          {slug!=='404'&&<nav class="next-reading" aria-label={fr?'Poursuivre votre parcours':'Continue your journey'}><div><span class="role">{fr?'Et maintenant ?':'What’s next?'}</span><h2>{fr?'Choisissez votre prochaine étape.':'Choose your next step.'}</h2></div><div class="actions"><a class="btn" href={path('offre/exemple','offer/example')}>{fr?'Voir un diagnostic simulé':'See a simulated diagnostic'} →</a><a class="btn btn-primary" href={slug==='contact'?path('offre','offer'):path('contact')}>{slug==='contact'?(fr?'Consulter l’offre':'Read the offer'):(fr?'Parlons de votre cas':'Let’s discuss your case')} ↗</a></div></nav>}
        </article>
        <aside class="toc" id="toc" hidden><p>{t.toc}</p><ol></ol><a class="toc-help" href={path('contact')}>{fr?'Un cas à examiner ?':'A case to examine?'}<strong>{fr?'Échangeons':'Let’s talk'} ↗</strong></a></aside>
      </>}
    </main>
    <footer class="site-footer"><div class="footer-top"><div class="footer-brand"><a class="brand" href={url(fr?'/':'/en/')}><span class="brand-name">TENIR<span class="brand-labs">LABS</span></span></a><p>{fr?'Des actions encadrées.\nDes décisions éclairées.':'Bounded actions.\nInformed decisions.'}</p><a href="mailto:skiredj@tenirlabs.cc">skiredj@tenirlabs.cc ↗</a><a class="footer-prototype" href="https://mobile.tenirlabs.cc/discover">{fr?'Explorer le prototype mobile':'Explore the mobile prototype'} ↗</a></div><div class="footer-links">{footerGroups.map(group=><div><h2>{group.label}</h2>{group.links.map(link=><a href={url(link.href)}>{link.label}</a>)}</div>)}</div></div><div class="footer-bottom"><p>© 2026 Abdelaziz Skiredj · TENIR Labs</p><p>{fr?'Cadre en développement · démonstrations bornées · aucune certification':'Framework in development · bounded demonstrations · no certification'}</p><a href={path('statut','status')}>{fr?'Statut et limites':'Status and limits'} ↗</a></div></footer>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
