---
import '../styles/fonts.css';
import '../styles/site.css';
import '../styles/experience.css';
import '../styles/journeys.css';
import '../styles/responsibility.css';
import '../styles/sector-map.css';
import '../styles/execution-video.css';
import '../styles/process-roles.css';
import MarketingHome from '../components/MarketingHome.astro';
import ContactBrief from '../components/ContactBrief.astro';
import { journeys, journeyHref } from '../data/journeys';
import { businessHref } from '../data/business';
import { portfolioContactHref } from '../data/contact';
import { alternate, copy, navContact, navGroups, navProducts, url, type Locale } from '../data/site';
interface Props { locale: Locale; slug: string; title: string; description: string; kicker: string; lede: string; sources: string; }
const { locale, slug, title, description, kicker, lede, sources } = Astro.props;
const fr=locale==='fr', t=copy[locale], groups=navGroups[locale], products=navProducts[locale], contact=navContact[locale];
const home=slug==='';
const isCredibility=slug==='credibilite'||slug==='credibility';
const isJourney=slug.startsWith('parcours/')||slug.startsWith('start/');
const isBusiness=slug==='parcours/activite'||slug==='start/business';
const isPortfolio=slug.startsWith('portfolio/');
const isProcessRoles=slug==='processus-et-roles';
const other=slug==='404'?(fr?'/en/':'/'):alternate(locale,slug);
const here=slug==='404'?'/':fr?(slug?`/${slug}/`:'/'):`/en/${slug?`${slug}/`:''}`;
const canonical=new URL(url(here),Astro.site);
const path=(f:string,e:string=f)=>url(fr?`/${f}/`:`/en/${e}/`);
const selectedJourney=journeys[locale].find(j=>slug===(fr?`parcours/${j.slug}`:`start/${j.slug}`));
const readerContact=home?path('parcours-ia','ai-readiness'):isPortfolio?portfolioContactHref(locale,slug.split('/')[1]):path('contact')+(selectedJourney?`?situation=${selectedJourney.id}`:'');
const pageKinds: Record<string, string> = {
  offre: fr?'Service':'Service', offer:'Service',
  'diagnostic-execution': fr?'Diagnostic spécialisé':'Specialized diagnostic',
  'credibilite': fr?'Parcours Crédibilité':'Credibility Journey', 'credibility': fr?'Parcours Crédibilité':'Credibility Journey',
  'produits-et-services': 'Service · REG', 'products-and-services': 'Service · REG',
  'offre/exemple': fr?'Exemple simulé':'Simulated example', 'offer/example':'Simulated example',
  'architecture/demo': fr?'Démonstration':'Demo', 'architecture/interactive': fr?'Démonstration interactive':'Interactive demo',
  'architecture/drawing': fr?'Document illustratif':'Illustrative document',
  concepts: fr?'Cadre et recherche':'Framework and research', standard: fr?'Standard proposé':'Proposed standard',
  depots: fr?'Sources logicielles':'Software sources', repositories:'Software sources',
};
const demo=groups[2];
const resources=[...groups[3].links,...groups[4].links,...groups[0].links.filter(x=>x.slug!=='concepts'),groups[1].links[0],groups[1].links[4],{slug:fr?'contribuer':'contribute',href:fr?'/contribuer/':'/en/contribute/',label:fr?'Contribuer':'Contribute'}];
const footerGroups=[
  {id:'discover',label:fr?'Découvrir':'Discover',links:[{slug:'credibility',href:fr?'/credibilite/':'/en/credibility/',label:fr?'Parcours Crédibilité':'Credibility Journey'},{slug:'ai-pathway',href:fr?'/parcours-ia/':'/en/ai-readiness/',label:fr?'Faire le point sur un cas':'Review one situation'},{slug:fr?'parcours/decouvrir':'start/discover',href:journeyHref(locale,journeys[locale][0]),label:fr?'Comprendre TENIR':'Understand TENIR'},{slug:'portfolio/products',href:fr?'/portfolio/products/':'/en/portfolio/products/',label:fr?'Produits':'Products'},{slug:fr?'parcours/activite':'start/business',href:businessHref(locale),label:fr?'En pratique':'In practice'}]},
  {id:'try',label:fr?'Explorer et essayer':'Explore and try',links:[{slug:'prototype',href:'https://mobile.tenirlabs.cc/discover',label:fr?'Prototype mobile':'Mobile prototype'},demo.links[0],{slug:fr?'offre/exemple':'offer/example',href:fr?'/offre/exemple/':'/en/offer/example/',label:fr?'Un exemple sourcé':'A sourced example'}]},
  {id:'study',label:fr?'Approfondir':'Go deeper',links:[groups[3].links[1],groups[3].links[3],...groups[4].links.slice(1)]},
  {id:'talk',label:fr?'Échanger':'Talk',links:[contact,{slug:fr?'offre':'offer',href:fr?'/offre/':'/en/offer/',label:fr?'Un accompagnement':'Accompanied work'},{slug:fr?'contribuer':'contribute',href:fr?'/contribuer/':'/en/contribute/',label:fr?'Contribuer':'Contribute'}]},
];
const mainTitle=home?(fr?'TENIR Labs — L’IA agit. Vous gardez la main.':'TENIR Labs — AI takes action. You stay in control.'):`${title} — TENIR`;
const mainDescription=home?(fr?'Confiez des tâches à l’IA, pas les clés de votre entreprise. TENIR Labs aide à encadrer les actions des agents IA, anticiper les risques et reprendre la main lorsque le résultat est incertain.':'Give AI the work, not the keys to your business. TENIR Labs helps you govern AI-agent actions, anticipate risk and respond when the outcome is uncertain.'):description;
---
<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{mainTitle}</title><meta name="description" content={mainDescription} />
    <link rel="canonical" href={canonical} /><link rel="alternate" hreflang={locale} href={canonical} /><link rel="alternate" hreflang={fr?'en':'fr'} href={new URL(url(other),Astro.site)} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#f6f7f2" />
    <meta property="og:title" content={mainTitle} /><meta property="og:description" content={mainDescription} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} /><meta property="og:locale" content={fr?'fr_FR':'en_GB'} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { var saved=localStorage.getItem('tenir-theme'); document.documentElement.dataset.theme=(saved==='dark'||saved==='light')?saved:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'); } catch(e) {}
    </script>
  </head>
  <body class:list={[home&&'marketing-page',isCredibility&&'credibility-page']}>
    <a class="skip" href="#content">{t.skip}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={url(fr?'/':'/en/')}><svg class="mark" viewBox="0 0 32 32" aria-hidden="true"><rect x="1" y="1" width="30" height="30" rx="4" fill="none" stroke="currentColor" stroke-width="1.2"></rect><path d="M10 8h12M16 8v16M10 24h12" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg><span class="brand-name">TENIR<span class="brand-labs">LABS</span></span></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" data-menu-toggle><span>Menu</span><span class="menu-symbol" aria-hidden="true">☰</span></button>
        <nav class="site-nav" id="main-navigation" aria-label={t.nav}>
          <a href={home?url(fr?'/':'/en/'):url(journeyHref(locale,journeys[locale][0]))} aria-current={home?'page':slug===(fr?'parcours/decouvrir':'start/discover')?'page':undefined}>{home?(fr?'Accueil':'Overview'):(fr?'Découvrir':'Discover')}</a>
          {!home&&<a href={path('parcours-ia','ai-readiness')}>{fr?'Aperçu de maturité':'Maturity preview'}</a>}
          <a href={path('processus-et-roles')} aria-current={isProcessRoles?'page':undefined}>{fr?'Processus & rôles':'Process & Roles'}</a>
          <a href={path('portfolio/products')} aria-current={slug==='portfolio/products'?'page':undefined}>{fr?'Produits':'Products'}</a>
          {!home&&<a href={path('credibilite','credibility')} aria-current={isCredibility?'page':undefined}>{fr?'Crédibilité':'Credibility'}</a>}
          <a href={home?path('portfolio/demos'):url(businessHref(locale))} aria-current={slug===(fr?'parcours/activite':'start/business')?'page':undefined}>{home?(fr?'Démos':'Demos'):(fr?'En pratique':'In practice')}</a>
          <details class="nav-group" hidden={home}><summary>{fr?'Essayer':'Try it'}</summary><div class="nav-menu"><a href={path('portfolio/demos')}><strong>{fr?'Voir les démonstrations':'Browse the demos'}</strong><small>{fr?'Scénarios, schémas et exemples à explorer':'Scenarios, diagrams and examples to explore'}</small></a><a href="https://mobile.tenirlabs.cc/discover"><strong>{fr?'Une tâche de rendez-vous':'An appointment task'}</strong><small>{fr?'Prototype mobile · aucun vrai message envoyé':'Mobile prototype · no real messages sent'}</small></a>{demo.links.map(link=><a href={url(link.href)} aria-current={link.slug===slug?'page':undefined}>{link.label}</a>)}</div></details>
          {home&&<a href={path('credibilite','credibility')}>{fr?'Crédibilité':'Evidence'}</a>}
          {home&&<a href={path('produits-et-services','products-and-services')}>{fr?'Approche':'Approach'}</a>}
          <details hidden={home} class:list={['nav-group',resources.some(x=>x.slug===slug)&&'is-current']}><summary>{fr?'Ressources':'Resources'}</summary><div class="nav-menu resource-menu">{resources.map(link=><a href={url(link.href)} aria-current={link.slug===slug?'page':undefined}>{link.label}</a>)}</div></details>
          <div class="nav-mobile-tools"><a href={url(other)} lang={fr?'en':'fr'}>{fr?'Read in English':'Lire en français'}</a></div>
        </nav>
        <div class="tools"><nav class="lang" aria-label={t.lang}><a href={url(fr?here:other)} lang="fr" aria-current={fr&&slug!=='404'?'true':undefined}>FR</a><a href={url(fr?other:here)} lang="en" aria-current={!fr&&slug!=='404'?'true':undefined}>EN</a></nav><button class="theme" type="button" data-theme-toggle aria-pressed="false" aria-label={t.themeToDark} data-label-dark={t.themeToDark} data-label-light={t.themeToLight}><span class="label-light" aria-hidden="true">◐</span><span class="label-dark" aria-hidden="true">◑</span></button><a class="btn btn-primary header-cta" href={home?path('pourquoi-maintenant','why-now'):readerContact}>{home?(fr?'Pourquoi maintenant ?':'Why now?'):(fr?'Poser une question':'Ask a question')} <span aria-hidden="true">↗</span></a></div>
      </div>
    </header>
    <main id="content" class:list={[(home||isCredibility)?'home-main':'doc',slug==='contact'&&'contact-page',isBusiness&&'business-page',isPortfolio&&'portfolio-page']} tabindex="-1">
      {isCredibility ? <slot/> : home ? <><MarketingHome locale={locale}/><details class="reading-note"><summary>{fr?'Statut, sources et limites de cette présentation':'Status, sources and limits of this presentation'}</summary><div class="prose"><p class="sources">{t.sources} : {sources}</p><slot /></div></details></> : <>
        <article>
          <nav class="breadcrumb" aria-label={fr?'Fil d’Ariane':'Breadcrumb'}><a href={url(fr?'/':'/en/')}>{fr?'Accueil':'Home'}</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
          <header class="doc-head"><p class="kicker">{pageKinds[slug]&&<span>{pageKinds[slug]} · </span>}{kicker}</p><h1>{title}</h1>{!isPortfolio&&<><p class="lede">{lede}</p>{slug!=='contact'&&<details class="source-disclosure"><summary>{fr?'Sources et contexte de lecture':'Sources and reading context'}</summary><p class="sources">{sources}</p><p>{t.status} <a href={path('statut','status')}>{fr?'Lire le statut détaillé':'Read the detailed status'} →</a></p></details>}</>}</header>
          {slug==='contact'&&<ContactBrief locale={locale}/>}
          {(slug==='offre'||slug==='offer'||slug==='produits-et-services'||slug==='products-and-services')&&<div class="offer-summary"><div><span class="role">{fr?'Le point de départ':'The starting point'}</span><strong>{fr?'Un cas précis. Une fiche sourcée. Une suite à décider.':'One precise case. A sourced sheet. A next step to decide.'}</strong><p>{fr?'Cadrage proposé : 30 min · forfait sur devis · format à confirmer':'Proposed scoping: 30 min · fixed quote · format to confirm'}</p></div><a class="btn btn-primary" href={path('contact')}>{fr?'Préparer le premier échange':'Prepare the first conversation'} →</a></div>}
{slug!=='contact'&&<details class="mobile-toc" data-mobile-toc hidden><summary>{t.toc}</summary><ol></ol></details>}
          {isBusiness||isPortfolio?<slot />:slug==='contact'?<details class="contact-references"><summary>{fr?'Références de l’auteur et citations':'Author references and citations'}</summary><div class="prose"><slot /></div></details>:<div class="prose"><slot /></div>}
          {slug!=='404'&&!isJourney&&!isPortfolio&&<nav class="next-reading" aria-label={fr?'Poursuivre votre parcours':'Continue your journey'}><div><span class="role">{fr?'À votre rythme':'At your own pace'}</span><h2>{fr?'Qu’est-ce qui vous serait utile maintenant ?':'What would be useful to you now?'}</h2></div><div class="actions"><a class="btn" href={url(journeyHref(locale,journeys[locale][0]))}>{fr?'Une explication simple':'A simple explanation'} →</a><a class="btn btn-primary" href={slug==='contact'?path('offre/exemple','offer/example'):path('contact')}>{slug==='contact'?(fr?'Voir un exemple':'See an example'):(fr?'Poser une question':'Ask a question')} ↗</a></div></nav>}
        </article>
{slug!=='contact'&&<aside class="toc" id="toc" hidden><p>{t.toc}</p><ol></ol><a class="toc-help" href={readerContact}>{fr?'Une question en lisant ?':'A question while reading?'}<strong>{fr?'Écrire à Abdelaziz':'Write to Abdelaziz'} ↗</strong></a><a class="toc-help" href={url(journeyHref(locale,journeys[locale][0]))}>{fr?'Revenir à une explication simple':'Return to a simple explanation'} →</a></aside>}
      </>}
    </main>
    <footer class="site-footer"><div class="footer-top"><div class="footer-brand"><a class="brand" href={url(fr?'/':'/en/')}><span class="brand-name">TENIR<span class="brand-labs">LABS</span></span></a><p>{fr?'Des actions encadrées.\nDes décisions éclairées.':'Bounded actions.\nInformed decisions.'}</p><a href="mailto:skiredj@tenirlabs.cc">skiredj@tenirlabs.cc ↗</a><a class="footer-prototype" href="https://mobile.tenirlabs.cc/discover">{fr?'Explorer le prototype mobile':'Explore the mobile prototype'} ↗</a></div><div class="footer-links">{footerGroups.map(group=><div><h2>{group.label}</h2>{group.links.map(link=><a href={url(link.href)}>{link.label}</a>)}</div>)}</div></div><div class="footer-bottom"><p>© 2026 Abdelaziz Skiredj · TENIR Labs</p><p>{fr?'Cadre en développement · démonstrations bornées · aucune certification':'Framework in development · bounded demonstrations · no certification'}</p><a href={path('statut','status')}>{fr?'Statut et limites':'Status and limits'} ↗</a></div></footer>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
