---
import Base from "../layouts/Base.astro";
import ResponsibilityVisuals from "../components/ResponsibilityVisuals.astro";

const modules = import.meta.glob("../content/fr/*.md", { eager: true });

export function getStaticPaths() {
  const pages = import.meta.glob("../content/fr/*.md", { eager: true });
  return Object.keys(pages)
    .map((path) => path.split("/").pop()!.replace(/\.md$/, ""))
    .filter((slug) => slug !== "home")
    .map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const mod = modules[`../content/fr/${slug}.md`] as {
  Content: any;
  frontmatter: {
    title: string;
    description: string;
    kicker: string;
    lede: string;
    sources: string;
  };
};
const { Content, frontmatter } = mod;
---

<Base locale="fr" slug={slug!} {...frontmatter}>
  {slug === 'acteurs' && <ResponsibilityVisuals kind="actors" locale="fr" />}
  {slug === 'cas' && <ResponsibilityVisuals kind="cases" locale="fr" />}
  <Content />
</Base>
