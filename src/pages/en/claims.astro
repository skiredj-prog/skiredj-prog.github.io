---
import Base from '../../layouts/Base.astro';
import { publishableClaims, allNonClaims, holdE1A6Stats, type Claim, type NonClaim } from '../../data/claims';
import { url } from '../../data/site';

const claims = publishableClaims;
const s = holdE1A6Stats;

const statusLabel: Record<string, string> = {
  supported: 'Supported',
  partial: 'Partial',
  withdrawn: 'Withdrawn',
  experimental: 'Experimental',
};
const productLabel: Record<string, string> = {
  'tenir-gov': 'TENIR-Gov',
  hold: 'HOLD',
  'hold-b1': 'HOLD B1',
};
const counts = {
  all: claims.length,
  'tenir-gov': claims.filter((c: Claim) => c.product === 'tenir-gov').length,
  hold: claims.filter((c: Claim) => c.product !== 'tenir-gov').length,
};
---
<Base
  locale="en"
  slug="claims"
  title="Claims register"
  description="What TENIR Labs claims, on what basis, and with what limit. Every claim is anchored to a verifiable commit."
  kicker="Reference"
  lede="What we claim, on what basis, and how far. Every entry carries its anchor and its limit — and the list of what we do not claim is part of the register."
  sources="TENIR-Gov v5.7.0 · commit 092bb45 · HOLD E1-A6 · commit f3bb683 · Harv Banning audit of 3 November 2026"
>

  <p>A claim enters this register only when it is tied to a published commit, an archived experiment run, or a documented audit. Work sitting on an experimental branch stays out until it is merged.</p>

  <div class="cl-filters" role="group" aria-label="Filter claims">
    <button type="button" class="cl-filter is-active" data-filter="all" aria-pressed="true">All <span>{counts.all}</span></button>
    <button type="button" class="cl-filter" data-filter="tenir-gov" aria-pressed="false">TENIR-Gov <span>{counts['tenir-gov']}</span></button>
    <button type="button" class="cl-filter" data-filter="hold" aria-pressed="false">HOLD <span>{counts.hold}</span></button>
  </div>

  <ul class="cl-list" data-claims-list>
    {claims.map((c: Claim) => (
      <li class="cl-item" data-product={c.product === 'tenir-gov' ? 'tenir-gov' : 'hold'}>
        <div class="cl-head">
          <code class="cl-id">{c.id}</code>
          <span class={`cl-badge is-${c.status}`}>{statusLabel[c.status]}</span>
          <span class="cl-product">{productLabel[c.product]}</span>
        </div>
        <p class="cl-statement">{c.statement.en}</p>
        <p class="cl-basis"><span>Basis:</span> {c.basis.en}</p>
        <p class="cl-limit"><span>Limit:</span> {c.limit.en}</p>
        <p class="cl-anchor">Anchor: <code>{c.anchor}</code></p>
      </li>
    ))}
  </ul>

  <h2>What we do not claim</h2>

  <p>This second list has the same standing as the first. It is maintained in the same source file, and a statement only moves between lists on evidence.</p>

  <ul class="cl-negatives">
    {allNonClaims.map((item: NonClaim) => (
      <li>{item.relatedClaim && <code class="cl-nc-id">{item.relatedClaim}</code>}<strong>{item.statement.en}</strong> <span>{item.reason.en}</span></li>
    ))}
  </ul>

  <h2>Figures at a glance</h2>

  <p>The figures below come from the E1-A6 experiment and its audit. They are read straight from the site’s single source of truth.</p>

  <div class="cl-stats">
    <div><strong>{s.totalRuns}</strong><span>HOLD E1-A6 runs</span></div>
    <div><strong>{s.conditions.A.violations} → {s.conditions.C.violations}</strong><span>violations: agent alone → under HOLD</span></div>
    <div><strong>{s.audit.passed.toLocaleString('en-GB')}</strong><span>audit checks passed</span></div>
    <div><strong>{claims.length}</strong><span>publishable claims</span></div>
  </div>

  <p><a href={url('/en/hold/')}>HOLD E1-A6 experiment in detail →</a><br /><a href={url('/en/credibility/')}>TENIR-Gov credibility journey →</a></p>

</Base>

<style>
  .cl-filters { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.6rem 0 1.4rem; }
  .cl-filter {
    font: 600 .8rem var(--sans);
    padding: .4rem .85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .cl-filter span { font-variant-numeric: tabular-nums; opacity: .6; margin-left: .3rem; }
  .cl-filter:hover { border-color: var(--line-strong); }
  .cl-filter.is-active { background: var(--accent-soft); border-color: var(--accent); color: var(--ink); }
  .cl-filter:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

  .cl-list { list-style: none; padding: 0; margin: 0 0 2.4rem; display: grid; gap: .85rem; }
  .cl-item {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.1rem 1.2rem;
    background: var(--bg-raised);
    margin: 0;
  }
  .cl-item[hidden] { display: none; }
  .cl-head { display: flex; align-items: center; flex-wrap: wrap; gap: .55rem; margin-bottom: .6rem; }
  .cl-id { font: 600 .74rem var(--mono); background: var(--code-bg); padding: .15rem .45rem; border-radius: 4px; }
  .cl-badge {
    font: 600 .66rem var(--mono);
    letter-spacing: .04em;
    text-transform: uppercase;
    padding: .18rem .5rem;
    border-radius: 999px;
    border: 1px solid currentColor;
  }
  .cl-badge.is-supported { color: #2d7a63; }
  .cl-badge.is-partial { color: #9a6b1e; }
  .cl-badge.is-withdrawn { color: var(--limit); }
  .cl-badge.is-experimental { color: var(--muted); }
  .cl-product { font: 600 .68rem var(--mono); letter-spacing: .05em; color: var(--muted); margin-left: auto; }

  .cl-statement { font-weight: 600; color: var(--ink); margin: 0 0 .55rem; line-height: 1.5; }
  .cl-basis, .cl-limit { font-size: .85rem; color: var(--ink-soft); margin: 0 0 .35rem; line-height: 1.55; }
  .cl-basis span, .cl-limit span { font-weight: 600; color: var(--muted); }
  .cl-anchor { font-size: .74rem; color: var(--muted); margin: .5rem 0 0; }
  .cl-anchor code { font-size: .72rem; }

  .cl-negatives { margin-bottom: 2.2rem; }
  .cl-negatives li { margin-bottom: .6rem; }
  .cl-negatives strong { color: var(--ink); }
  .cl-negatives span { color: var(--muted); }
  .cl-nc-id { font: 600 .7rem var(--mono); background: var(--code-bg); padding: .1rem .35rem; border-radius: 4px; margin-right: .3rem; }

  .cl-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    margin: 1.2rem 0 2rem;
  }
  .cl-stats > div { background: var(--bg-raised); padding: 1.1rem; min-width: 0; }
  .cl-stats strong { display: block; font-size: 1.5rem; line-height: 1; font-variant-numeric: tabular-nums; color: var(--ink); }
  .cl-stats span { display: block; font-size: .76rem; color: var(--muted); margin-top: .45rem; line-height: 1.4; }

  :root[data-theme='dark'] .cl-badge.is-supported { color: #5aba9b; }
  :root[data-theme='dark'] .cl-badge.is-partial { color: #dfb871; }

  @media (max-width: 560px) {
    .cl-stats { grid-template-columns: repeat(2, 1fr); }
    .cl-product { margin-left: 0; }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.cl-filter');
  const items = document.querySelectorAll<HTMLLIElement>('.cl-item');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'all';
      buttons.forEach((other) => {
        const active = other === button;
        other.classList.toggle('is-active', active);
        other.setAttribute('aria-pressed', String(active));
      });
      items.forEach((item) => {
        item.hidden = filter !== 'all' && item.dataset.product !== filter;
      });
    });
  });
</script>
