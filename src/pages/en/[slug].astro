---
import Base from "../../layouts/Base.astro";
import ResponsibilityVisuals from "../../components/ResponsibilityVisuals.astro";
import SectorGovernanceMap from "../../components/SectorGovernanceMap.astro";
import ExecutionBoundaryVideo from "../../components/ExecutionBoundaryVideo.astro";
import { sectorCasesEn } from "../../data/sectorCases";

const modules = import.meta.glob("../../content/en/*.md", { eager: true });

export function getStaticPaths() {
  const pages = import.meta.glob("../../content/en/*.md", { eager: true });
  return Object.keys(pages)
    .map((path) => path.split("/").pop()!.replace(/\.md$/, ""))
    .filter((slug) => slug !== "home")
    .map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const mod = modules[`../../content/en/${slug}.md`] as {
  Content: any;
  frontmatter: {
    title: string;
    description: string;
    kicker: string;
    lede: string;
    sources: string;
  };
};
const { Content, frontmatter } = mod;
---

<Base locale="en" slug={slug!} {...frontmatter}>
  <Content />
  {slug === 'actors' && <ResponsibilityVisuals kind="actors" locale="en" />}
  {slug === 'cases' && <><ExecutionBoundaryVideo locale="en" /><ResponsibilityVisuals kind="cases" locale="en" /><SectorGovernanceMap sector={sectorCasesEn['banque-assurance']} locale="en" /><SectorGovernanceMap sector={sectorCasesEn['transport-mobilite']} locale="en" /></>}
</Base>
