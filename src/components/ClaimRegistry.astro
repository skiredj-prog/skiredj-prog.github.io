---
import {claimRecords, type EvidenceStatus} from '../data/claim-registry';
import type {Locale} from '../data/site';
interface Props {locale: Locale}
const {locale} = Astro.props;
const fr = locale==='fr';
const label: Record<EvidenceStatus,{fr:string;en:string}> = {
  SPECIFIED: {fr:'Spécifié',en:'Specified'},
  IMPLEMENTED: {fr:'Implémentation publiée',en:'Published implementation'},
  LAB_DEMONSTRATED: {fr:'Observé en laboratoire',en:'Observed in laboratory'},
  EXTERNAL_RERUN_REPORTED: {fr:'Rejeu externe rapporté',en:'External rerun reported'},
  NOT_QUALIFIED: {fr:'Non qualifié',en:'Not qualified'},
};
---
<section class="prose" id="registre-preuves" data-claim-registry>
  <h2>{fr?'Registre de traçabilité des affirmations':'Claim traceability register'}</h2>
  <p>{fr?'État de lecture du 20 novembre 2026. Ce registre est un index éditorial vers des sources figées, non un certificat ou un résultat de tests exécutés par ce site.':'Review snapshot dated 20 November 2026. This is an editorial index of pinned sources, not a certification or a test result generated by this website.'}</p>
  <div class="table-scroll">
    <table class="fit">
      <caption>{fr?'Chaque affirmation conserve son niveau, son périmètre, ses limites et la source exacte.':'Each claim retains its level, scope, limitations and exact source.'}</caption>
      <thead><tr>
        <th scope="col">{fr?'Sujet et version':'Subject and version'}</th>
        <th scope="col">{fr?'État':'Status'}</th>
        <th scope="col">{fr?'Ce que la source établit':'Source-bound claim'}</th>
        <th scope="col">{fr?'Ce qui n’est pas établi':'Not established'}</th>
      </tr></thead>
      <tbody>
        {claimRecords.map(record=><tr data-claim-id={record.id} data-status={record.status}>
          <td><strong>{record.subject}</strong><small>{record.subjectRevision}</small><p><a href={record.subjectUrl} rel="noopener noreferrer">{fr?'Révision précise':'Pinned revision'} ↗</a></p></td>
          <td><strong>{label[record.status][locale]}</strong><small>{record.environment[locale]}</small></td>
          <td>{record.claim[locale]}<p><a href={record.evidenceUrl} rel="noopener noreferrer">{record.evidenceLabel} ↗</a></p></td>
          <td>{record.limitations[locale]}</td>
        </tr>)}
      </tbody>
    </table>
  </div>
  <p>{fr?'Règle de lecture : un PASS local, une release ou un résultat externe rapporté ne monte pas de catégorie sans une preuve qui répond aux exigences de cette catégorie.':'Reading rule: a local PASS, a release, or a reported external result does not advance to a stronger evidence class without evidence satisfying that class.'}</p>
</section>
