---
import '../styles/portfolio.css';
import PortfolioMatrix from './PortfolioMatrix.astro';
import { portfolioAccess } from '../data/portfolioAccess';
import { portfolio, portfolioHubs, hubStatus, profilePath, type PortfolioLocale } from '../data/portfolio';
import { url } from '../data/site';
import { portfolioContactHref } from '../data/contact';
import { stagesFor } from '../data/processRoles';
interface Props { locale: PortfolioLocale; page: string; }
const { locale, page } = Astro.props;
const fr = locale === 'fr';
const hub = (portfolioHubs[locale] as Record<string, any>)[page];
const entry = portfolio[locale][page];
const publicAccess = portfolioAccess[locale][page];
const path = (route:string) => url((fr?'/':'/en/') + route + '/');
const cardHref = (id:string) => url(profilePath(locale, id));
const kindName = (kind:string) => ({product:fr?'Produit ou instrument':'Product or instrument',service:'Service',demo:fr?'Démonstration':'Demo',foundation:fr?'Cadre et recherche':'Framework and research'} as Record<string,string>)[kind] ?? kind;
// Products hub: three readiness tiers. The tier is the only status shown on the hub;
// engineering detail (gates, pending tests, PR numbers) stays on each profile.
const item = (id:string) => portfolio[locale][id];
const shortStatus = (id:string) => hubStatus(item(id).status);
const available = ['diagnostic','gov','conformance'].map(item);
const tiers = [
  {id:'pilot',label:fr?'En pilote':'In pilot',note:fr?'Démarche cadrée par un document de travail, à tester sur un cas réel avec vous.':'An approach framed by a working draft, to be tested with you on a real case.',entries:['prevent','prepare'].map(item)},
  {id:'prototype',label:fr?'En prototype':'In prototype',note:fr?'Explorations en cours. Aucune n’est qualifiée pour la production.':'Explorations in progress. None is qualified for production.',entries:['explorer','discovery','mediation','xray','translation'].map(item)},
];
const foundations = ['reg-arch','technical'].map(item);
// Demos hub: one list, grouped by what the visitor does. Only demos that can be opened today.
const demoGroups = [
  {label:fr?'À manipuler':'Hands-on',note:fr?'Vous cliquez, la simulation répond.':'You click, the simulation responds.',items:[
    {title:fr?'Examiner règles, scénarios et preuves':'Inspect rules, scenarios and evidence',name:'REG DEMO',text:fr?'Quatre scénarios fixes et des preuves signées localement. La lecture ne déclenche aucune action.':'Four fixed scenarios and locally signed evidence. Reading does not trigger an action.',meta:fr?'Prototype non officiel · aucun système réel connecté':'Unofficial prototype · no live system connected',href:'https://tenirlabs.cc/tenir-reg-demo/index.html',label:fr?'Ouvrir REG DEMO':'Open REG DEMO'},
    {title:fr?'Un système qui approche de sa limite':'A system approaching its limit',name:'TENIR Workbench',text:fr?'Pression, capacité, marge. Trois lectures — observer, décider, vérifier — sur des chiffres illustratifs. Aucune commande ne part.':'Pressure, capacity, margin. Three readings — observe, decide, verify — on illustrative figures. No command is sent.',meta:fr?'Français et anglais · lecture seule · synthétique':'French and English · read-only · synthetic',href:path('workbench'),label:fr?'Ouvrir TENIR Workbench':'Open TENIR Workbench'},
    {title:fr?'Ce que le journal ne voit pas':'What the log cannot see',name:fr?'Comparaison de deux sources':'Two-source comparison',text:fr?'Deux lignes semblent cohérentes. Une autre source révèle une demande manquante.':'Two entries look consistent. Another source reveals a missing request.',meta:fr?'Français et anglais · données fictives':'French and English · fictional data',href:path(fr?'demonstrations/journal':'demos/log'),label:fr?'Comparer les deux sources':'Compare the two sources'},
    {title:fr?'Comment les pièces se relient-elles ?':'How do the pieces fit together?',name:fr?'Schéma interactif':'Interactive diagram',text:fr?'Les composants de l’architecture et les limites publiées, à parcourir.':'The architecture components and published limits, to explore.',meta:fr?'En anglais':'In English',href:path('architecture/interactive'),label:fr?'Explorer le schéma':'Explore the diagram'},
    {title:fr?'Une tâche de rendez-vous, pour essayer':'An appointment task to try',name:fr?'Prototype mobile':'Mobile prototype',text:fr?'Proposez un créneau, simulez une réponse, puis mettez en pause.':'Propose a slot, simulate a reply, then pause.',meta:fr?'Site distinct · données d’exemple, aucun vrai message':'Separate site · example data, no real messages',href:'https://mobile.tenirlabs.cc/discover',label:fr?'Ouvrir le prototype mobile':'Open the mobile prototype'},
  ]},
  {label:fr?'À suivre':'To watch',note:fr?'Un scénario se déroule, vous avancez scène par scène.':'A scenario unfolds, you move scene by scene.',items:[
    {title:fr?'Un paiement, un doublon, une interruption':'A payment, a duplicate, an interruption',name:fr?'Replay bancaire fictif PAY-MAR-001':'Fictional banking replay PAY-MAR-001',text:fr?'Une opération normale, un doublon, une interruption, puis la réconciliation.':'A normal operation, a duplicate, an interruption, then reconciliation.',meta:fr?'En français · simulation synthétique, aucun paiement réel':'In French · synthetic simulation, no real payment',href:url('/embeds/demonstration-bancaire.html'),label:fr?'Ouvrir le replay':'Open the replay'},
    {title:fr?'Une autorisation ne confirme pas l’effet':'Authorization does not confirm an effect',name:fr?'Parcours en six scènes':'Six-scene walkthrough',text:fr?'Autorisation, doublon, interruption et résultat inconnu.':'Authorization, duplicate, interruption and unknown outcome.',meta:fr?'En anglais':'In English',href:path('architecture/demo'),label:fr?'Ouvrir les six scènes':'Open the six scenes'},
  ]},
  {label:fr?'À lire':'To read',note:fr?'Ce à quoi ressemble un travail rendu.':'What delivered work looks like.',items:[
    {title:fr?'Du scénario à la restitution':'From scenario to readout',name:fr?'Fiche simulée':'Simulated sheet',text:fr?'Un exemple de fiche : constats, sources et questions encore ouvertes.':'A sample sheet: findings, sources and open questions.',meta:fr?'Exemple fictif · aucune référence client':'Fictional example · no client reference',href:path(fr?'offre/exemple':'offer/example'),label:fr?'Lire la fiche simulée':'Read the simulated sheet'},
    {title:fr?'Configurer et relire des preuves':'Configure and review evidence',name:'TENIR/REG · Diagnostic & Evidence Workbench',text:fr?'Présentation du configurateur et des preuves synthétiques. Le ZIP de consultation n’est pas distribué sur ce site.':'An overview of the configuration tool and synthetic records. The consultation ZIP is not distributed on this website.',meta:fr?'Présentation seulement':'Overview only',href:path('portfolio/workbench'),label:fr?'Lire la présentation':'Read the overview'},
  ]},
];
const external = (h:string) => h.startsWith('https:');
const stagesPage = fr ? '/processus-et-roles/' : '/en/processus-et-roles/';
const whenLabel = fr ? 'Quand l’utiliser :' : 'When to use it:';
const labels = fr ? [
  ['when','Cela peut vous aider si…'],['inputs','Ce qu’il faut pour commencer'],['examines','Ce que l’on examine'],
  ['pain','La question de départ'],['relationships','Les liens avec les autres approches'],
  ['maturity','Disponibilité et maturité'],['limits','Les limites à connaître'],['next','Une suite possible'],
] : [
  ['when','This may help when…'],['inputs','What you need to start'],['examines','What is examined'],
  ['pain','The starting question'],['relationships','How it connects to other approaches'],
  ['maturity','Availability and maturity'],['limits','Limits to keep in mind'],['next','A possible next step'],
];
const href = (route:string) => route.startsWith('#')?route:url(route);
const contactHref = portfolioContactHref(locale, page);
const nextHref = entry && (entry.nextHref === '/contact/' || entry.nextHref === '/en/contact/') ? contactHref : entry ? href(entry.nextHref) : contactHref;
const actionNote = entry?.nextHref === '/contact/' || entry?.nextHref === '/en/contact/'
  ? (fr?'Page de contact · préparez un message à relire avant envoi.':'Contact page · prepare a message to review before sending.')
  : entry?.nextHref.startsWith('#')
    ? (fr?'Simulation interactive ci-dessous · à lancer à votre rythme.':'Interactive simulation below · start at your own pace.')
    : entry?.nextHref.startsWith('https://github.com/')
      ? (fr?'Ressource externe sur GitHub · sources et documentation.':'External GitHub resource · source and documentation.')
      : (fr?'Explication ou démonstration sur ce site.':'Explanation or demonstration on this site.');
---
<div class="pf-root">
  {hub ? <>
    {page==='products'&&<>
      <PortfolioMatrix locale={locale} />
      <section class="pf-tier pf-tier-available" aria-labelledby="pf-available-title">
        <header class="pf-tier-head"><h2 id="pf-available-title">{fr?'Ce que vous pouvez obtenir aujourd’hui':'What you can get today'}</h2><p>{fr?'Une offre à prix fixe, puis deux logiciels publiés, chacun dans un périmètre précis.':'One fixed-price offer, then two published software releases, each within a precise scope.'}</p></header>
        <div class="pf-offer-grid">{available.map((e:any)=>{const access=portfolioAccess[locale][e.id];return <article class="pf-offer">
          <h3><a href={cardHref(e.id)}>{e.tagline}</a></h3>
          <p class="pf-offer-name">{e.title}</p>
          <p class="pf-offer-output">{e.output}</p>
          <p class="pf-offer-status">{shortStatus(e.id)}</p>
          {stagesFor(locale,e.id).length>0&&<p class="pf-when">{whenLabel} {stagesFor(locale,e.id).map((st,i)=><>{i>0&&' · '}<a href={url(stagesPage+'#'+st.id)}>{st.name}</a></>)}</p>}
          <div class="pf-offer-links"><a href={cardHref(e.id)}>{e.id==='diagnostic'?(fr?'Voir l’offre':'See the offer'):(fr?'Voir la fiche':'View profile')}</a>{access&&<a href={url(access.href)}>{access.label}{external(access.href)&&<span aria-hidden="true"> ↗</span>}</a>}{e.id==='gov'&&<a href={url(fr?'/affirmations/#claim-tg-1':'/en/claims/#claim-tg-1')}>{fr?'Preuves':'Evidence'}</a>}</div>
        </article>;})}</div>
      </section>
      {tiers.map(tier=><section class="pf-tier" aria-labelledby={'pf-tier-'+tier.id}>
        <header class="pf-tier-head"><h2 id={'pf-tier-'+tier.id}>{tier.label}</h2><p>{tier.note}</p></header>
        <ul class="pf-rows">{tier.entries.map((e:any)=><li class="pf-row"><div><h3><a href={cardHref(e.id)}>{e.tagline}</a></h3><p>{e.title}</p>{stagesFor(locale,e.id).length>0&&<p class="pf-when">{whenLabel} {stagesFor(locale,e.id).map((st,i)=><>{i>0&&' · '}<a href={url(stagesPage+'#'+st.id)}>{st.name}</a></>)}</p>}</div><span class="pf-row-status">{shortStatus(e.id)}</span></li>)}</ul>
      </section>)}
      <p class="pf-foundations">{fr?'Vous cherchez l’architecture ou les contrats techniques ?':'Looking for the architecture or the technical contracts?'} {foundations.map((e:any,i:number)=><>{i>0&&' · '}<a href={cardHref(e.id)}>{e.title}</a></>)}</p>
    </>}
    {page==='demos'&&<>
      <section class="pf-feature">
        <div><h2>{fr?'La réponse manque. Que faire ensuite ?':'The response is missing. What comes next?'}</h2><p>{fr?'Commencez ici : la Control Tower met en scène quatre situations. Choisissez un scénario et observez les décisions et les états simulés.':'Start here: Control Tower presents four situations. Choose a scenario and inspect the simulated decisions and states.'}</p><a class="btn btn-primary" href={cardHref('control-tower')}>{fr?'Ouvrir la simulation interactive':'Open the interactive simulation'}</a><small>{fr?'En anglais · aucune connexion au noyau réel':'In English · no live kernel connected'}</small></div>
        <div class="pf-scenario-preview" aria-hidden="true"><div>{fr?'Une proposition':'A proposal'} <b>→</b></div><div>{fr?'Une autorisation':'An authorization'} <b>→</b></div><div class="pf-scenario-unknown">{fr?'Un résultat à vérifier':'An outcome to verify'} <i>?</i></div></div>
      </section>
      <section class="pf-demo-list" aria-labelledby="pf-demos-title">
        <header class="pf-tier-head"><h2 id="pf-demos-title">{fr?'Toutes les démonstrations':'All demos'}</h2><p>{fr?'Scénarios fictifs et bornés : aucune n’agit sur un système réel.':'Fictional, bounded scenarios: none acts on a real system.'}</p></header>
        {demoGroups.map(group=><section class="pf-demo-group"><header><h3>{group.label}</h3><p>{group.note}</p></header>
          <ul class="pf-rows">{group.items.map(d=><li class="pf-row pf-demo-card"><div><h4>{d.title}</h4><p>{d.name}. {d.text}</p><small>{d.meta}</small></div><a class="pf-row-action" href={d.href}>{d.label}{external(d.href)&&<span aria-hidden="true"> ↗</span>}</a></li>)}</ul>
        </section>)}
      </section>
      <p class="pf-foundations">{fr?'Pour examiner votre propre périmètre, et non un scénario :':'To examine your own scope rather than a scenario:'} <a href={cardHref('diagnostic')}>{fr?'voir l’offre Leap Readiness':'see the Leap Readiness offer'}</a>.</p>
    </>}
  </> : entry ? <>
    {page==='xray'&&<section id="explorer" class="pf-xray-explore" aria-labelledby="xray-explore-title">
      <p class="pf-overline">{fr?'Éclairage X-Ray · exemples illustratifs':'X-Ray perspective · illustrative examples'}</p>
      <h2 id="xray-explore-title">{fr?'L’IA, dans un geste ordinaire.':'AI in an everyday task.'}</h2>
      <p>{fr?'Ouvrez un exemple et regardez ce qui mérite une question. Sans inscription, sans données à fournir.':'Open an example and see what is worth asking. No sign-up and no data to provide.'}</p>
      <div class="reader-reflections">
        <details><summary>{fr?'Une réunion résumée automatiquement':'An automatically summarized meeting'}</summary><p>{fr?'Dans cet exemple fictif, un assistant transforme un enregistrement en compte rendu. Qui a accès à l’audio ? Où est-il conservé ? Une personne vérifie-t-elle les décisions avant de diffuser le résumé ?':'In this fictional example, an assistant turns a recording into meeting notes. Who can access the audio? Where is it stored? Does someone check the decisions before sharing the summary?'}</p></details>
        <details><summary>{fr?'Une réponse client suggérée':'A suggested customer reply'}</summary><p>{fr?'Dans cet exemple fictif, un outil prépare une réponse à partir de l’historique des échanges. Quelles informations utilise-t-il ? La réponse reste-t-elle un brouillon ? Qui vérifie les engagements avant l’envoi ?':'In this fictional example, a tool drafts a reply using the conversation history. Which information does it use? Does the reply stay a draft? Who checks any commitments before sending?'}</p></details>
        <details><summary>{fr?'Un document classé automatiquement':'An automatically sorted document'}</summary><p>{fr?'Dans cet exemple fictif, une facture est lue puis orientée vers un dossier. Que se passe-t-il si elle est mal classée ? Peut-on retrouver le document d’origine, comprendre le choix et le corriger ?':'In this fictional example, an invoice is read and routed to a folder. What if it is misclassified? Can someone find the original, understand the choice and correct it?'}</p></details>
      </div>
      <p class="pf-action-note">{fr?'Ces exemples donnent des repères de lecture. Ils n’analysent aucun de vos outils ; le statut du prototype X-Ray est précisé ci-dessous.':'These examples offer a way to look at a situation. They do not analyze any of your tools; the X-Ray prototype status is described below.'}</p>
    </section>}
    <section class="pf-detail-hero"><div><p class="pf-overline">{kindName(entry.kind)}</p><h2>{entry.tagline}</h2><p class="pf-detail-lead">{entry.pain}</p><dl class="pf-highlight"><div class="pf-field pf-output"><dt>{fr?'Ce que vous recevez':'What you receive'}</dt><dd>{entry.output}</dd></div></dl><div class="pf-actions"><a class="btn btn-primary" href={nextHref}>{entry.nextLabel} <span aria-hidden="true">{entry.nextHref.startsWith('http')?'↗':'→'}</span></a>{page!=='diagnostic'&&<a class="text-link" href={cardHref('diagnostic')}>{fr?'Voir l’accompagnement':'See the guided engagement'} →</a>}</div><p class="pf-action-note">{actionNote}</p></div><aside class="pf-status-card"><span class="pf-aside-label">{fr?'Disponibilité':'Availability'}</span><strong>{entry.status}</strong><p>{entry.limits}</p></aside></section>
    {publicAccess && <div class="pf-direct-access" aria-label={fr?'Accès public identifié':'Identified public access'}>
      <div><span class="pf-overline">{fr?'RESSOURCE ACCESSIBLE':'AVAILABLE RESOURCE'}</span>
      <strong>{publicAccess.label}</strong>
      <p>{publicAccess.scope}</p></div>
      <a class="btn" href={url(publicAccess.href)}>{fr?'Accéder à la ressource':'Open resource'} ↗</a>
    </div>}
    {page==='prepare'&&<p class="pf-action-note" data-capture-bridge><a href={path(fr?'demonstrations/journal':'demos/log')}>{fr?'Voir un exemple : ce que le journal ne voit pas':'See an example: what the log cannot see'} →</a></p>}
    {page==='experiences'&&<section class="pf-conclusion" aria-label={fr?'Approfondir avec le Workbench':'Workbench follow-up'}>
      <div><h2>TENIR/REG · Diagnostic &amp; Evidence Workbench</h2><p>{fr?'Une lecture plus technique de la configuration et des preuves simulées ; le ZIP de consultation n’est pas distribué sur ce site.':'A deeper introduction to configuration and synthetic signed evidence; the consultation ZIP is not distributed on this website.'}</p></div>
      <a class="btn" href={path('portfolio/workbench')}>{fr?'Comprendre le Workbench':'Understand the Workbench'} →</a>
    </section>}
    {page==='reg-arch'&&<section id="reg-arch-lifecycle" class="pf-embed-section"><div class="pf-embed-heading"><div><span class="pf-overline">{fr?'REG-ARCH · CYCLE DE VIE DES DÉCISIONS':'REG-ARCH · DECISION LIFECYCLE'}</span><h2>{fr?'Une demande, une décision, son application : trois faits distincts.':'A request, a decision, its application: three distinct facts.'}</h2><p>{fr?'Neuf cycles, quatorze portes, trois domaines : prétention, action, représentation. Choisissez un cycle, puis comparez un refus et une décision acceptée mais non appliquée.':'Nine lifecycles, fourteen gates, three lanes: claim, action, representation. Pick a lifecycle, then compare a refusal with a decision that is accepted but not applied.'}</p></div><a href={url(fr?'/embeds/reg-lifecycle-workbench.html':'/embeds/reg-lifecycle-workbench.html?lang=en')} target="_blank" rel="noopener noreferrer">{fr?'Ouvrir en plein écran':'Open full screen'} ↗</a></div><iframe loading="lazy" title={fr?'REG-ARCH, cycle de vie des décisions : démonstration de conception, sans exécution':'REG-ARCH decision lifecycle: design demonstration, no execution'} src={url(fr?'/embeds/reg-lifecycle-workbench.html':'/embeds/reg-lifecycle-workbench.html?lang=en')} class="pf-demo-frame"></iframe><p class="pf-frame-note">{fr?'Démonstration de conception · événements synthétiques · aucun lien avec TENIR-Gov ni avec un système réel.':'Design demonstration · synthetic events · no connection to TENIR-Gov or any real system.'}</p></section>}
    {page==='control-tower'&&<section id="control-tower-experience" class="pf-embed-section"><div class="pf-embed-heading"><div><span class="pf-overline">AUTONOMY CONTROL TOWER v1.0</span><h2>{fr?'Choisissez un scénario. Regardez ce qui change.':'Choose a scenario. See what changes.'}</h2><p>{fr?'Le simulateur est en anglais. Sélectionnez l’une des quatre situations, puis lancez le parcours quand vous le souhaitez.':'The simulator is in English. Select one of the four situations, then start when you are ready.'}</p></div><a href={url('/embeds/reg-autonomy-control-tower-v1.0.html')} target="_blank" rel="noopener noreferrer">{fr?'Ouvrir en plein écran':'Open full screen'} ↗</a></div><iframe loading="lazy" title="REG Autonomy Control Tower v1.0 — interactive English-language simulation, no live kernel" src={url('/embeds/reg-autonomy-control-tower-v1.0.html')} class="pf-demo-frame"></iframe><p class="pf-frame-note">{fr?'Scénario synthétique · noyau non connecté · sur mobile, le plein écran facilite la lecture.':'Synthetic scenario · no live kernel connected · full screen makes mobile reading easier.'}</p></section>}
    <section class="pf-details" aria-labelledby="pf-details-title"><header class="pf-details-head"><h2 id="pf-details-title">{fr?'Pour savoir si cela vous correspond':'See whether it fits your situation'}</h2></header><dl>{labels.map(([key,label])=><div class:list={['pf-field',key==='limits'&&'pf-field-limit']}><dt>{label}</dt><dd>{(entry as any)[key]}</dd></div>)}</dl></section>
    <section class="pf-related"><h2>{fr?'Cela se relie aussi à…':'It also connects to…'}</h2><div class="pf-related-grid">{entry.related.map(id=><a href={cardHref(id)}><span>{portfolio[locale][id].title} →</span><small>{kindName(portfolio[locale][id].kind)} · {portfolio[locale][id].tagline}</small></a>)}</div></section>
    <details class="pf-sources"><summary>{fr?'Lire les sources et les repères de version':'Read sources and version references'}</summary><div class="pf-source-links">{entry.sources.map(s=><a href={href(s.href)}>{s.label} {s.href.startsWith('http')?'↗':'→'}</a>)}</div><p>{fr?'Les disponibilités et les limites ci-dessus reflètent les sources citées. Les révisions d’artefacts non vérifiées restent indiquées.':'Availability and limits above reflect the cited sources. Unverified artifact revisions remain identified.'}</p></details>
  </> : <p>{fr?'Page non disponible.':'Page unavailable.'}</p>}
</div>
