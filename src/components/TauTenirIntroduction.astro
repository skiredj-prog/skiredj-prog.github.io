---
import type { Locale } from '../data/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const fr = locale === 'fr';
const copy = fr ? {
  label:'TAU / TENIR · introduction', title:'Ce document n’est pas', accent:'un manuel', subtitle:'Une invitation à penser autrement la décision, la pression et l’identité des systèmes qui doivent durer.', preface:'Ce document n’est pas le référentiel technique de TAU / TENIR. C’est une introduction accessible à une façon de penser les décisions qui doivent traverser la pression sans perdre ce qu’elles protègent.', quote:'Les systèmes ne s’effondrent pas parce qu’ils manquent de ressources. Ils s’effondrent parce que, sous pression, ils perdent ce qui les définissait.', question:'Comment un système — une organisation, une institution, un projet ou une personne — peut-il traverser la pression sans perdre ce qu’il est ?', tauTitle:'TAU — L’invariant', tauLead:'Ce qui reste quand tout le reste disparaît.', tauText:'TAU désigne le noyau irréductible d’un système : les engagements non négociables, les principes directeurs ou la relation de confiance qu’il ne peut pas sacrifier sans cesser d’être lui-même.', tauQ:'Si tout ce qui est externe disparaissait — marché, partenaires, réputation — qu’est-ce qui ferait que votre organisation est encore elle-même ?', tenirTitle:'TENIR — Tenir debout', tenirLead:'Maintenir son intégrité décisionnelle face à la contrainte.', tenirText:'Tenir n’est pas seulement résister. C’est maintenir une posture, une direction et une intégrité décisionnelle face à l’action précipitée, à la capitulation silencieuse ou à la dérive progressive.', knowledgeTitle:'Le savoir — Ce que l’on sait vraiment', knowledgeLead:'Avant de décider, connaître la valeur de ce que l’on sait.', knowledgeText:'Une information n’est pas encore une preuve. Il faut regarder sa traçabilité, ses sources, ses biais possibles et sa dérive dans le temps. Quand cette base est insuffisante, suspendre le diagnostic est une forme de rigueur.', agencyTitle:'Agence et trajectoire', agencyLead:'Qui peut agir, et où en sommes-nous ?', agencyText:'Même un diagnostic juste ne suffit pas si personne ne peut agir sur ses conclusions. Les acteurs, les décisions déjà prises et les options déjà fermées déterminent ce qui reste possible.', reflectionTitle:'Réflexion guidée', reflectionIntro:'Ces questions ne constituent pas un diagnostic formel. Elles aident à situer une organisation avant de choisir une action.', questions:['Qu’est-ce que votre organisation ne peut pas sacrifier, même sous pression ?','Quelles décisions actuelles ferment des options futures ?','Quelles informations importantes sont encore incertaines ou non vérifiées ?','Qui tient réellement les leviers qui peuvent changer la trajectoire ?'], closeTitle:'Une introduction, pas une certification', closeText:'TAU / TENIR propose un langage pour observer la tenue d’un système. Il ne remplace ni une enquête, ni une décision responsable, ni les preuves nécessaires à une application concrète.'
} : {
  label:'TAU / TENIR · introduction', title:'This document is not', accent:'a manual', subtitle:'An invitation to think differently about decisions, pressure and the identity of systems that must endure.', preface:'This is not the technical reference for TAU / TENIR. It is an accessible introduction to thinking about decisions that must cross pressure without losing what they protect.', quote:'Systems do not collapse because they lack resources. They collapse because, under pressure, they lose what defined them.', question:'How can a system — an organisation, institution, project or person — cross pressure without losing what it is?', tauTitle:'TAU — The invariant', tauLead:'What remains when everything else disappears.', tauText:'TAU names a system’s irreducible core: the non-negotiable commitments, guiding principles or trust relationship it cannot sacrifice without ceasing to be itself.', tauQ:'If everything external disappeared — market, partners, reputation — what would make your organisation still itself?', tenirTitle:'TENIR — Holding true', tenirLead:'Maintaining decisional integrity under constraint.', tenirText:'Holding is not simply resisting. It means maintaining a posture, direction and decisional integrity against hasty action, silent capitulation or gradual drift.', knowledgeTitle:'Knowledge — What we really know', knowledgeLead:'Before deciding, understand the value of what we know.', knowledgeText:'Information is not yet evidence. Look at traceability, sources, possible bias and drift over time. When that base is insufficient, suspending a diagnosis is rigour.', agencyTitle:'Agency and trajectory', agencyLead:'Who can act, and where are we?', agencyText:'Even a sound diagnosis is insufficient if nobody can act on its conclusions. Actors, decisions already made and options already closed determine what remains possible.', reflectionTitle:'Guided reflection', reflectionIntro:'These questions are not a formal diagnosis. They help situate an organisation before choosing an action.', questions:['What can your organisation not sacrifice, even under pressure?','Which current decisions are closing future options?','Which important information remains uncertain or unverified?','Who actually holds the levers that can change the trajectory?'], closeTitle:'An introduction, not a certification', closeText:'TAU / TENIR offers a language for observing how a system holds. It does not replace inquiry, responsible decision-making or the evidence required for concrete application.'
};
---
<div class="tau-page">
  <nav class="tau-local-nav" aria-label={fr?'Chapitres de l’introduction':'Introduction chapters'}><a href="#preface">{fr?'Préambule':'Preface'}</a><a href="#tau">I · TAU</a><a href="#tenir">II · TENIR</a><a href="#knowledge">III · {fr?'Le savoir':'Knowledge'}</a><a href="#agency">IV · {fr?'Agence':'Agency'}</a><a href="#reflection">V · {fr?'Réflexion':'Reflection'}</a></nav>
  <header class="tau-hero" id="preface"><p class="tau-eyebrow">{copy.label}</p><h2>{copy.title}<em>{copy.accent}</em></h2><p class="tau-subtitle">{copy.subtitle}</p><p>{copy.preface}</p><blockquote>{copy.quote}<cite>— {fr?'Prémisse fondatrice · TAU / TENIR':'Founding premise · TAU / TENIR'}</cite></blockquote><p class="tau-question">{copy.question}</p></header>
  <section class="tau-section" id="tau"><p class="tau-number">I</p><p class="tau-eyebrow">{fr?'Chapitre I · Le concept fondateur':'Chapter I · The founding concept'}</p><h2>{copy.tauTitle}</h2><p class="tau-lead">{copy.tauLead}</p><p>{copy.tauText}</p><div class="tau-note"><strong>{fr?'Question fondatrice':'Founding question'}</strong><p>{copy.tauQ}</p></div><p>{fr?'Nommer ce noyau est la première étape d’un diagnostic sérieux. Un invariant non nommé est un invariant non défendu.':'Naming this core is the first step of serious diagnosis. An unnamed invariant is an undefended one.'}</p></section>
  <section class="tau-section tau-section--tinted" id="tenir"><p class="tau-number">II</p><p class="tau-eyebrow">{fr?'Chapitre II · Le mécanisme':'Chapter II · The mechanism'}</p><h2>{copy.tenirTitle}</h2><p class="tau-lead">{copy.tenirLead}</p><p>{copy.tenirText}</p><div class="tau-postures"><article><span>●</span><h3>{fr?'Normale':'Normal'}</h3><p>{fr?'Les fondations sont claires. Les décisions préservent les options futures.':'Foundations are clear. Decisions preserve future options.'}</p></article><article><span>◐</span><h3>{fr?'Prudence':'Caution'}</h3><p>{fr?'La pression monte. Il faut ralentir, clarifier et préserver avant d’agir.':'Pressure is rising. Slow down, clarify and preserve before acting.'}</p></article><article><span>○</span><h3>{fr?'Tenir d’abord':'Hold first'}</h3><p>{fr?'Une décision irréversible est proche. Certaines actions doivent attendre.':'An irreversible decision is near. Some actions must wait.'}</p></article></div></section>
  <section class="tau-section" id="knowledge"><p class="tau-number">III</p><p class="tau-eyebrow">{fr?'Chapitre III · La qualité du savoir':'Chapter III · The quality of knowledge'}</p><h2>{copy.knowledgeTitle}</h2><p class="tau-lead">{copy.knowledgeLead}</p><p>{copy.knowledgeText}</p><div class="tau-triad"><div><strong>{fr?'Qualité des preuves':'Evidence quality'}</strong><span>{fr?'Ce qui est établi, vérifié et traçable.':'What is established, verified and traceable.'}</span></div><div><strong>{fr?'Risque de manipulation':'Manipulation risk'}</strong><span>{fr?'Ce qui pourrait être distordu par les intérêts en présence.':'What interests could distort.'}</span></div><div><strong>{fr?'Dérive dans le temps':'Drift over time'}</strong><span>{fr?'Ce qui était vrai hier ne l’est peut-être plus aujourd’hui.':'What was true yesterday may not be true today.'}</span></div></div></section>
  <section class="tau-section tau-section--tinted" id="agency"><p class="tau-number">IV</p><p class="tau-eyebrow">{fr?'Chapitre IV · La dynamique du changement':'Chapter IV · The dynamics of change'}</p><h2>{copy.agencyTitle}</h2><p class="tau-lead">{copy.agencyLead}</p><p>{copy.agencyText}</p><div class="tau-split"><div><strong>{fr?'Agence':'Agency'}</strong><p>{fr?'Qui contrôle réellement les variables qui comptent ?':'Who really controls the variables that matter?'}</p></div><div><strong>{fr?'Trajectoire':'Trajectory'}</strong><p>{fr?'Quelles décisions ont déjà fermé des options ?':'Which decisions have already closed options?'}</p></div></div></section>
  <section class="tau-section" id="reflection"><p class="tau-number">V</p><p class="tau-eyebrow">{fr?'Chapitre V · Réflexion guidée':'Chapter V · Guided reflection'}</p><h2>{copy.reflectionTitle}</h2><p class="tau-lead">{copy.reflectionIntro}</p><ol class="tau-questions">{copy.questions.map((q,i)=><li><span>0{i+1}</span><p>{q}</p></li>)}</ol></section>
  <footer class="tau-close"><h2>{copy.closeTitle}</h2><p>{copy.closeText}</p><a class="btn btn-primary" href={fr?'/parcours-ia/':'/en/ai-readiness/'}>{fr?'Faire le point sur mon point de départ':'Assess my starting point'} →</a></footer>
</div>
