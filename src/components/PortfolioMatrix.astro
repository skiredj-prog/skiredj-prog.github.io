---
import '../styles/product-matrix.css';
import { portfolio, type PortfolioLocale } from '../data/portfolio';
import { url } from '../data/site';
interface Props { locale: PortfolioLocale }
const { locale } = Astro.props;
const fr = locale === 'fr';
const href = (id: string) => url((fr ? '/portfolio/' : '/en/portfolio/') + id + '/');
const cells = [
  {
    title: fr ? 'Avant de laisser agir · comprendre' : 'Before AI acts · understand',
    intro: fr ? 'Un outil ou un usage d’IA apparaît. Vous voulez savoir ce qu’il peut toucher et qui doit regarder.' : 'An AI tool or use appears. You want to know what it can affect and who should look.',
    items: [['discovery', fr ? 'Faire l’inventaire d’un usage IA' : 'Map an AI use'], ['xray', fr ? 'Repérer une exposition déjà présente' : 'Spot existing exposure']]
  },
  {
    title: fr ? 'Avant de laisser agir · préparer' : 'Before AI acts · prepare',
    intro: fr ? 'Une décision se prépare. Il faut savoir quelles conditions vérifier avant de laisser partir l’action.' : 'A decision is being prepared. You need to know what to check before the action goes out.',
    items: [['prevent', fr ? 'Traduire une règle en contrôles candidats' : 'Turn a rule into candidate controls'], ['translation', fr ? 'Rendre une exigence testable' : 'Make a requirement testable'], ['mediation', fr ? 'Comparer des profils et hypothèses' : 'Compare profiles and assumptions']]
  },
  {
    title: fr ? 'Après une action · comprendre' : 'After an action · understand',
    intro: fr ? 'Une action a eu lieu. Vous devez distinguer ce qui était prévu, envoyé, confirmé ou reste inconnu.' : 'An action happened. You need to separate what was intended, sent, confirmed or remains unknown.',
    items: [['prepare', fr ? 'Rassembler une preuve lisible' : 'Assemble readable evidence'], ['explorer', fr ? 'Explorer les frontières et dépendances' : 'Explore boundaries and dependencies']]
  },
  {
    title: fr ? 'Après une action · vérifier' : 'After an action · verify',
    intro: fr ? 'Une action sensible doit rester dans un cadre déclaré, avec une réponse claire quand on ne sait pas encore ce qui s’est passé.' : 'A sensitive action needs a declared frame and a clear response when you do not yet know what happened.',
    items: [['gov', fr ? 'Encadrer une action d’agent' : 'Bound an agent action'], ['conformance', fr ? 'Tester un profil de manière bornée' : 'Test a bounded profile']]
  }
];
const status = (id: string) => portfolio[locale][id].status;
const title = (id: string) => id === 'gov' ? 'TENIR-Gov' : id === 'conformance' ? 'REG Conformance' : portfolio[locale][id].title;
---
<section class="portfolio-matrix" aria-labelledby="portfolio-matrix-title">
  <header class="pm-heading">
    <div><p class="pf-overline">{fr ? 'Récapitulatif · choisir un point de départ' : 'Recap · choose a starting point'}</p><h2 id="portfolio-matrix-title">{fr ? 'Avant ou après l’action ?' : 'Before or after the action?'}</h2></div>
    <p>{fr ? 'Commencez par la situation que vous reconnaissez. Les fiches détaillent ensuite le résultat, le statut et les limites de chaque instrument.' : 'Start with the situation you recognize. Each profile then explains its output, status and limits.'}</p>
  </header>
  <div class="pm-2x2" role="region" tabindex="0" aria-label={fr ? 'Matrice 2 par 2 des produits TENIR Labs' : 'TENIR Labs 2 by 2 product matrix'}>
    {cells.map(cell => <section class="pm-cell"><h3>{cell.title}</h3><p>{cell.intro}</p><ul>{cell.items.map(([id, label]) => <li><a href={href(id)}><strong>{label}</strong><span aria-hidden="true">↗</span></a><small>{title(id)} · {status(id)}</small></li>)}</ul></section>)}
  </div>
  <div class="pm-transverse"><p>{fr ? 'TENIR aide à poser la question ; les produits et services répondent à des moments différents. Une simulation ne vaut pas preuve de production.' : 'TENIR frames the question; products and services address different moments. A simulation is not proof of production.'}</p><p><a href={href('diagnostic')}>{fr ? 'Commencer par un diagnostic accompagné' : 'Start with a guided diagnostic'}</a>{' · '}<a href={url(fr ? '/pourquoi-maintenant/' : '/en/why-now/')}>{fr ? 'Pourquoi maintenant ?' : 'Why now?'}</a></p></div>
</section>
