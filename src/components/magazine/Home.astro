---
// Accueil du magazine : choix de la langue, règles éditoriales, téléchargements.
import Magazine from '../../layouts/Magazine.astro';
import data from '../../data/magazine/n01.json';
import { url } from '../../data/site';
interface Props { path: string; }
const { path } = Astro.props;
type Lang = 'fr' | 'en' | 'ar';
const langs: Lang[] = ['fr', 'en', 'ar'];
const issue: Record<Lang, string> = { fr: '/magazine/n01/', en: '/magazine/n01/en/', ar: '/magazine/n01/ar/' };
const read: Record<Lang, string> = { fr: 'Lire en français', en: 'Read in English', ar: 'اقرأ بالعربية' };
const rules: Record<Lang, { title: string; items: string[] }> = {
  fr: { title: 'Nos règles', items: [
    'Chaque affirmation porte une étiquette : fait sourcé, lecture ou proposition.',
    'Les sources sont citées et datées. Une erreur signalée est corrigée en ligne, avec sa date.',
    'Aucune publicité dans ce numéro.',
    'Aucun organisme cité n’a financé ce numéro ni relu son contenu avant publication.' ] },
  en: { title: 'Our rules', items: [
    'Every statement carries a label: sourced fact, reading or proposal.',
    'Sources are cited and dated. A reported error is corrected online, with its date.',
    'No advertising in this issue.',
    'No organisation mentioned funded this issue or reviewed its content before publication.' ] },
  ar: { title: 'قواعدنا', items: [
    'كل معلومة تحمل وسماً: معطى موثّق، أو قراءة، أو اقتراح.',
    'المصادر مذكورة ومؤرَّخة. يُصحَّح كل خطأ مبلَّغ عنه في النسخة الإلكترونية مع ذكر تاريخه.',
    'لا إشهار في هذا العدد.',
    'لم تموّل أي جهة مذكورة هذا العدد، ولم تراجع محتواه قبل نشره.' ] },
};
const fr = (data as any).fr;
---
<Magazine lang="fr" title="TENIR — Les grands choix, expliqués · N° 01 Maroc 2030" description={fr.web.description} path={path} current="index" issueHref="/magazine/n01/" avisHref="/magazine/avis/?n=01&l=fr&s=web">
  <section class="mag-hero" slot="hero" aria-labelledby="titre">
    <div class="mag-hero-inner">
      <figure>
        <img src={url('/magazine/n01/couverture.jpg')} alt={fr.web.cover_alt} width="1100" height="895" />
        <figcaption>{fr.cover_caption}</figcaption>
      </figure>
      <div class="mag-hero-text">
        <p class="mag-kicker">{fr.issue_date} · {fr.kicker_cover}</p>
        <h1 id="titre">{fr.cover_title}</h1>
        <p class="mag-sub">{fr.cover_sub}</p>
        <div class="mag-actions">
          {langs.map((l) => <a class:list={['mag-btn', l === 'fr' ? 'mag-btn-primary' : 'mag-btn-ghost']} href={url(issue[l])} lang={l} hreflang={l}>{read[l]}</a>)}
        </div>
      </div>
    </div>
  </section>
  {langs.map((l) => {
    const d = (data as any)[l];
    return (
      <section class="mag-section" lang={l} dir={l === 'ar' ? 'rtl' : 'ltr'} aria-labelledby={`home-${l}`}>
        <p class="mag-kicker">{d.tagline}</p>
        <h2 id={`home-${l}`}>{d.cover_title} · {d.cover_sub}</h2>
        <p>{d.edito_body[2]}</p>
        <div class="mag-actions">
          <a class="mag-btn mag-btn-light" href={url(issue[l])}>{read[l]} →</a>
          <a class="mag-btn mag-btn-light" href={url(`/magazine/n01/TENIR-N01-${l.toUpperCase()}.pdf`)} download>{d.web.read_pdf}</a>
        </div>
        <h3>{rules[l].title}</h3>
        <ul class="mag-locks">{rules[l].items.map((r, i) => <li><span class="n" aria-hidden="true">{i + 1}</span><p>{r}</p></li>)}</ul>
      </section>
    );
  })}
  <Fragment slot="footer"><p>{fr.back_legal}</p></Fragment>
</Magazine>
