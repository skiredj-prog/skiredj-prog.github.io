---
import { url, type Locale } from '../data/site';
import ExecutionBoundaryVideo from './ExecutionBoundaryVideo.astro';
import LifecycleBand from './LifecycleBand.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const fr = locale === 'fr';
const path = (f: string, e: string = f) => url(fr ? `/${f}/` : `/en/${e}/`);
const steps = fr ? [
  ['01', 'Question', 'Partir de la décision à préparer.', 'Quelle action examine-t-on ? Quelle conséquence faut-il préserver ? La question définit le périmètre de travail.', 'Une question précise et un responsable identifié.'],
  ['02', 'Modèle', 'Expliciter ce que l’on cherche.', 'Décrire le système, les règles et les hypothèses. Choisir les propriétés et les observations nécessaires pour examiner la question.', 'Des hypothèses et un protocole d’observation.'],
  ['03', 'Observation', 'Recueillir ce qui est disponible.', 'Retrouver les données, leur origine et leur contexte : requête, réponse, journal ou état du destinataire. Une donnée absente reste absente.', 'Des données situées et des lacunes visibles.'],
  ['04', 'Interprétation', 'Séparer les faits des hypothèses.', 'Appliquer un protocole d’analyse explicite aux valeurs observées. Distinguer ce que la trace établit, ce que l’équipe déclare et ce qui reste inconnu.', 'Des constats reliés à leurs sources.'],
  ['05', 'Restitution', 'Rendre la conclusion utilisable.', 'Relier les constats à la question initiale. Expliquer les limites et le prochain contrôle à vérifier pour préparer une décision humaine.', 'Une fiche de diagnostic et une suite proposée.'],
  ['06', 'Suivi', 'Réexaminer à partir de nouvelles données.', 'Définir les indicateurs et le modèle de suivi. Comparer les observations dans le temps pour enrichir la connaissance et réviser les hypothèses.', 'Une nouvelle observation, une connaissance à actualiser.'],
] : [
  ['01', 'Question', 'Start with the decision to prepare.', 'Which action are we examining? Which consequence must be preserved? The question defines the scope.', 'A precise question and an identified owner.'],
  ['02', 'Model', 'Make the assumptions explicit.', 'Describe the system, rules and assumptions. Choose the properties and observations needed to examine the question.', 'Assumptions and an observation protocol.'],
  ['03', 'Observation', 'Collect what is available.', 'Find the data, its origin and context: request, response, log or recipient state. Missing data stays missing.', 'Contextual data and visible gaps.'],
  ['04', 'Interpretation', 'Separate facts from assumptions.', 'Apply an explicit analysis protocol to observed values. Distinguish what a trace establishes, what the team reports and what remains unknown.', 'Findings linked to their sources.'],
  ['05', 'Restitution', 'Make the conclusion useful.', 'Connect findings to the initial question. Explain the limits and the next control to check to prepare a human decision.', 'A diagnostic sheet and proposed next steps.'],
  ['06', 'Follow-up', 'Revisit with new observations.', 'Define indicators and a monitoring model. Compare observations over time to update knowledge and revisit assumptions.', 'A new observation and knowledge to update.'],
];
const entryPoints = fr ? [
  {type:'Service · sur devis',title:'Diagnostic des frontières d’exécution',text:'Un flux critique, ses doublons, ses interruptions et les preuves nécessaires avant une reprise.',href:path('diagnostic-execution'),action:'Examiner l’offre'},
  {type:'Démonstrations · données fictives',title:'Essayer les scénarios',text:'Voir les mécanismes de HOLD, de résultat inconnu et de réconciliation — sans effet client réel.',href:path('portfolio/demos'),action:'Explorer les démos'},
  {type:'Logiciel · bêta bornée',title:'TENIR-Gov v5.7.0',text:'Consulter les sources, les capacités et les limites de la gouvernance runtime mono-hôte.',href:path('portfolio/gov'),action:'Examiner le logiciel'},
  {type:'Cadre et méthode',title:'TENIR · Prevent / Prepare',text:'Comprendre le cadre, puis distinguer exigences, contrôles candidats et pièces démontrables.',href:path('produits-et-services','products-and-services'),action:'Lire les approches'},
] : [
  {type:'Service · scoped quotation',title:'Execution Boundary Diagnostic',text:'One critical flow, duplicate attempts, interruptions and evidence needed before any retry.',href:path('diagnostic-execution'),action:'Examine the offer'},
  {type:'Demos · fictional data',title:'Explore scenarios',text:'See HOLD, unknown outcomes and reconciliation — with no real customer-side effect.',href:path('portfolio/demos'),action:'Explore demos'},
  {type:'Software · bounded beta',title:'TENIR-Gov v5.7.0',text:'Read source, capabilities and limitations of the bounded single-host runtime governor.',href:path('portfolio/gov'),action:'Inspect the software'},
  {type:'Framework and method',title:'TENIR · Prevent / Prepare',text:'Understand the framework and separate requirements, candidate controls and supporting evidence.',href:path('produits-et-services','products-and-services'),action:'Read the approaches'},
];

---
<div class="landing">
  <section class="landing-hero guided-hero" aria-labelledby="home-title" data-hero data-locale={locale}>
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> {fr ? 'TENIR Labs · gouverner les conséquences' : 'TENIR Labs · governing consequences'}</p>
      <h1 id="home-title">{fr ? 'Quand une décision produit un effet,' : 'When a decision creates an effect,'}<br /><em>{fr ? 'qui peut encore répondre ?' : 'who can still answer for it?'}</em></h1>
      <p class="hero-lead">{fr ? 'TENIR relie la promesse, l’action, l’effet et la preuve. Si une crise survient, nous aidons à voir ce qui est établi, ce qui reste inconnu et quelle décision peut encore être prise.' : 'TENIR connects the promise, the action, the effect and the evidence. If a crisis follows, we help make clear what is established, what remains unknown and which decision is still possible.'}</p>
      <div class="actions">
        <a class="btn btn-primary" href={path('cas','cases')}>{fr ? 'Explorer les cas et les secteurs' : 'Explore the cases and sectors'} <span aria-hidden="true">→</span></a>
        <a class="btn btn-quiet" href={path('pourquoi-maintenant','why-now')}>{fr ? 'Comprendre le problème' : 'Understand the problem'} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <aside class="home-curiosity guided-hero-value" aria-labelledby="curiosity-title">
      <p class="eyebrow">{fr ? 'La valeur, en pratique' : 'The value, in practice'}</p>
      <h2 id="curiosity-title">{fr ? 'Avant de conclure,' : 'Before concluding,'}<br /><em>{fr ? 'savoir ce que l’on sait.' : 'know what you know.'}</em></h2>
      <ul class="hero-value-list"><li>{fr ? 'Relier chaque affirmation à sa source.' : 'Link each claim to its source.'}</li><li>{fr ? 'Arrêter une reprise quand l’état est inconnu.' : 'Stop a retry when the state is unknown.'}</li><li>{fr ? 'Donner à la personne responsable une suite praticable.' : 'Give the accountable person a practical next step.'}</li></ul>
      <small>{fr ? 'Pas une promesse d’autonomie. Un cadre pour garder la main.' : 'Not a promise of autonomy. A framework for keeping control.'}</small>
    </aside>
  </section>
  <section class="home-orientation" aria-labelledby="orientation-title">
    <div class="section-heading"><div><p class="eyebrow">{fr ? 'Commencer ici' : 'Start here'}</p><h2 id="orientation-title">{fr ? 'Vous cherchez quoi, exactement ?' : 'What are you trying to do?'}</h2></div><p>{fr ? 'Choisissez une situation. Le site vous conduit ensuite vers le cas, le secteur et la suite adaptés.' : 'Choose a situation. The site then leads you to the relevant case, sector and next step.'}</p></div>
    <div class="home-orientation-grid">
      <a class="orientation-card" href={path('pourquoi-maintenant','why-now')}><span class="role">01 · {fr ? 'Comprendre' : 'Understand'}</span><h3>{fr ? 'Je veux comprendre le problème.' : 'I want to understand the problem.'}</h3><p>{fr ? 'Pourquoi la responsabilité se disperse-t-elle entre fournisseur, intégrateur, équipe métier et personne impactée ?' : 'Why does responsibility spread across vendors, integrators, business teams and affected people?'}</p><span class="text-link">{fr ? 'Lire la thèse' : 'Read the thesis'} →</span></a>
      <a class="orientation-card" href={path('cas','cases')}><span class="role">02 · {fr ? 'Examiner' : 'Examine'}</span><h3>{fr ? 'J’ai un cas dans mon secteur.' : 'I have a case in my sector.'}</h3><p>{fr ? 'Commencez par une séquence, les joueurs, l’impact et la preuve disponible.' : 'Start with the sequence, the players, the impact and the available evidence.'}</p><span class="text-link">{fr ? 'Voir les cas' : 'See the cases'} →</span></a>
      <a class="orientation-card" href={fr ? '/parcours/concevoir/' : '/en/start/build/'}><span class="role">03 · {fr ? 'Préparer' : 'Prepare'}</span><h3>{fr ? 'Je prépare une action ou un agent.' : 'I am preparing an action or agent.'}</h3><p>{fr ? 'Nommer l’action, ses limites, son autorité et la preuve attendue avant de la laisser agir.' : 'Name the action, its limits, authority and expected evidence before letting it act.'}</p><span class="text-link">{fr ? 'Préparer l’examen' : 'Prepare the examination'} →</span></a>
    </div>
  </section>
  <section class="home-industries" aria-labelledby="industries-title">
    <div class="section-heading"><div><p class="eyebrow">{fr ? 'Industries et situations' : 'Industries and situations'}</p><h2 id="industries-title">{fr ? 'Où cela devient concret.' : 'Where it becomes concrete.'}</h2></div><a class="text-link" href={path('cas','cases')}>{fr ? 'Tous les cas et les cartes' : 'All cases and maps'} →</a></div>
    <div class="home-industry-grid">
      <a class="industry-card industry-card-featured" href={path('cas','cases')+'#banque-assurance'}><span class="role">{fr ? 'Banque · assurance · paiement' : 'Banking · insurance · payments'}</span><h3>{fr ? 'Un virement est autorisé. La confirmation disparaît.' : 'A transfer is authorized. Confirmation disappears.'}</h3><p>{fr ? 'Voir la séquence, les joueurs, le HOLD et la réconciliation avant toute reprise.' : 'See the sequence, players, HOLD and reconciliation before any retry.'}</p><span class="text-link">{fr ? 'Ouvrir la carte bancaire' : 'Open the banking map'} →</span></a>
      <a class="industry-card" href={path('cas','cases')+'#transport-mobilite'}><span class="role">{fr ? 'Transport · mobilité critique' : 'Transport · critical mobility'}</span><h3>{fr ? 'Une trajectoire doit changer. L’état réel est incertain.' : 'A trajectory must change. The actual state is uncertain.'}</h3><p>{fr ? 'Comprendre l’escalade, la procédure dégradée et la responsabilité de l’opérateur.' : 'Understand escalation, degraded operation and operator accountability.'}</p><span class="text-link">{fr ? 'Ouvrir la carte transport' : 'Open the transport map'} →</span></a>
      <a class="industry-card" href={path('cas','cases')}><span class="role">{fr ? 'Service client · intégration IA' : 'Customer service · AI integration'}</span><h3>{fr ? 'Une réponse devient une promesse.' : 'An answer becomes a promise.'}</h3><p>{fr ? 'Lire le cas Air Canada et distinguer le fait documenté de la matrice d’analyse.' : 'Read the Air Canada case and distinguish documented fact from analysis matrix.'}</p><span class="text-link">{fr ? 'Lire le cas sourcé' : 'Read the sourced case'} →</span></a>
    </div>
  </section>
  <LifecycleBand locale={locale} />
  <section class="home-products-demos" aria-labelledby="products-demos-title">
    <div class="section-heading"><div><p class="eyebrow">{fr ? 'Produits et démonstrations' : 'Products and demos'}</p><h2 id="products-demos-title">{fr ? 'Voir ce qui existe déjà.' : 'See what already exists.'}</h2></div><a class="text-link" href={path('portfolio/products')}>{fr ? 'Ouvrir le portefeuille' : 'Open the portfolio'} →</a></div>
    <div class="home-product-grid">
      <a class="product-card" href={path('portfolio/diagnostic')}><span class="role">{fr ? 'Offre · cadrage' : 'Offer · scoping'}</span><h3>{fr ? 'Diagnostic des frontières d’exécution' : 'Execution Boundary Diagnostic'}</h3><p>{fr ? 'Un flux critique, ses responsabilités, ses inconnues et la prochaine décision.' : 'One critical flow, its responsibilities, unknowns and next decision.'}</p><span class="text-link">{fr ? 'Voir le livrable' : 'See the deliverable'} →</span></a>
      <a class="product-card" href={path('portfolio/gov')}><span class="role">{fr ? 'Logiciel · bêta bornée' : 'Software · bounded beta'}</span><h3>TENIR-Gov v5.7.0</h3><p>{fr ? 'Gouvernance runtime mono-hôte, sources publiques et limites explicites.' : 'Single-host runtime governance, public sources and explicit limitations.'}</p><span class="text-link">{fr ? 'Examiner le logiciel' : 'Inspect the software'} →</span></a>
      <a class="product-card" href={path('portfolio/demos')}><span class="role">{fr ? 'Données fictives · sans effet réel' : 'Fictional data · no live effect'}</span><h3>{fr ? 'Scénarios et Control Tower' : 'Scenarios and Control Tower'}</h3><p>{fr ? 'Voir HOLD, résultat inconnu, doublon et réconciliation dans des démonstrations inspectables.' : 'See HOLD, unknown outcomes, duplicates and reconciliation in inspectable demos.'}</p><span class="text-link">{fr ? 'Lancer une démo' : 'Launch a demo'} →</span></a>
    </div>
  </section>
  <section class="landing-section" aria-labelledby="responsibility-title">
    <div class="section-heading"><div><p class="eyebrow">{fr ? 'La question centrale' : 'The central question'}</p><h2 id="responsibility-title">{fr ? 'Tout le monde veut l’agent. Qui répond de ce qu’il fait ?' : 'Everyone wants the agent. Who answers for what it does?'}</h2></div><p>{fr ? 'Une action traverse plusieurs promesses, mais la conséquence reste unique pour la personne qui la subit.' : 'An action crosses several promises, but the consequence remains singular for the person who bears it.'}</p></div>
    <div class="journey-grid home-examples">
      <a class="journey-card" href={path('acteurs','actors')}><span class="role">{fr ? 'Les joueurs' : 'The players'}</span><h3>{fr ? 'Qui promet, configure, autorise ou subit ?' : 'Who promises, configures, authorizes or bears the effect?'}</h3><p>{fr ? 'Cartographier les acteurs et leurs responsabilités réelles.' : 'Map the actors and their actual responsibilities.'}</p><span class="text-link">{fr ? 'Voir les acteurs' : 'See the players'} →</span></a>
      <a class="journey-card" href={path('cas','cases')}><span class="role">{fr ? 'Les séquences' : 'The sequences'}</span><h3>{fr ? 'Comment une promesse devient-elle un incident ?' : 'How does a promise become an incident?'}</h3><p>{fr ? 'Rejouer la chaîne entre délégation, effet et preuve disponible.' : 'Replay the chain between delegation, effect and available evidence.'}</p><span class="text-link">{fr ? 'Lire les cas' : 'Read the cases'} →</span></a>
      <a class="journey-card" href={path('apprendre','learn')}><span class="role">{fr ? 'Les distinctions' : 'The distinctions'}</span><h3>{fr ? 'Une politique est-elle une preuve ?' : 'Is a policy evidence?'}</h3><p>{fr ? 'Distinguer intention, contrôle, supervision, résultat et responsabilité.' : 'Separate intent, control, supervision, outcome and responsibility.'}</p><span class="text-link">{fr ? 'Apprendre à reconnaître' : 'Learn to recognize'} →</span></a>
    </div>
  </section>
  <section class="landing-section" id="comprendre" aria-labelledby="examples-title">
    <div class="section-heading"><div><p class="eyebrow">{fr ? 'En pratique' : 'In practice'}</p><h2 id="examples-title">{fr ? 'Quelques situations, pour voir.' : 'A few situations to explore.'}</h2></div><p>{fr ? 'Un exemple peut suffire à faire le lien.' : 'One example can make the connection.'}</p></div>
    <div class="journey-grid home-examples">
      <a class="journey-card" href={path('portfolio/prevent')}><span class="role">REG Prevent</span><h3>{fr ? 'Une règle change. Qu’est-ce que cela implique ?' : 'A rule changes. What does that mean in practice?'}</h3><p>{fr ? 'Repérer les décisions concernées et les vérifications à préparer.' : 'Identify the decisions affected and the checks to prepare.'}</p><span class="text-link">{fr ? 'Découvrir l’approche' : 'Discover the approach'} →</span></a>
      <a class="journey-card" href={path('portfolio/prepare')}><span class="role">REG Prepare</span><h3>{fr ? 'Une preuve est demandée. Où la retrouver ?' : 'Evidence is requested. Where can we find it?'}</h3><p>{fr ? 'Relier une affirmation aux pièces disponibles et rendre les manques visibles.' : 'Connect a claim to available records and make the gaps visible.'}</p><span class="text-link">{fr ? 'Voir ce que l’on examine' : 'See what is examined'} →</span></a>
      <a class="journey-card" href={path('portfolio/control-tower')}><span class="role">{fr ? 'Simulation interactive · anglais' : 'Interactive simulation · English'}</span><h3>{fr ? 'Un agent envoie une commande. La réponse manque.' : 'An agent sends an order. The response is missing.'}</h3><p>{fr ? 'Faut-il relancer ? Observer ce qui change dans un scénario simulé.' : 'Should it retry? See what changes in a simulated scenario.'}</p><span class="text-link">{fr ? 'Ouvrir la simulation' : 'Open the simulation'} →</span></a>
    </div>
  </section>
  <section class="landing-section substance-section" aria-labelledby="substance-title"><div class="section-heading"><div><p class="eyebrow">{fr?'Les repères TENIR':'TENIR, in context'}</p><h2 id="substance-title">{fr?'Et derrière ces exemples ?':'What’s behind these examples?'}</h2></div><p>{fr?'TENIR, REG et le logiciel : des rôles distincts, des sources à explorer.':'TENIR, REG and the software: distinct roles, with sources to explore.'}</p></div><div class="substance-grid">
    <a href={path('concepts')}><span class="role">{fr?'Le cadre':'The framework'}</span><h3>TENIR</h3><p>{fr?'Le diagnostic des systèmes sous pression et la préservation des options.':'Diagnosing systems under pressure and preserving options.'}</p><span class="text-link">{fr?'Comprendre les repères':'Understand the concepts'} →</span></a>
    <a href={path('produits-et-services','products-and-services')}><span class="role">{fr?'Le standard et sa médiation':'The standard and its mediation'}</span><h3>REG · REG+</h3><p>{fr?'REG spécifie les conditions de l’exécution ; REG+ explore la médiation entre exigences, hypothèses et profils candidats. Les méthodes Prevent / Prepare examinent les contrôles et leurs preuves.':'REG specifies conditions for execution; REG+ explores mediation from requirements and assumptions to candidate profiles. Prevent / Prepare methods examine controls and evidence.'}</p><span class="text-link">{fr?'Voir les rôles et contrats':'See roles and contracts'} →</span></a>
    <a href={path('depots','repositories')}><span class="role">{fr?'Le logiciel en évaluation':'Software under evaluation'}</span><h3>TENIR-Gov</h3><p>{fr?'Du code public en évaluation, avec ses tests et leurs limites.':'Public code under evaluation, with tests and their limits.'}</p><span class="text-link">{fr?'Voir le code et les dépôts':'See code and repositories'} →</span></a>
  </div><div class="demo-shelf"><div><h3>{fr?'Vous préférez voir les mécanismes ?':'Prefer to see the mechanisms?'}</h3><p>{fr?'Démonstrations techniques bornées, sans action sur votre système.':'Bounded technical demonstrations, with no action on your system.'}</p></div><a href={path('architecture/demo')}>{fr?'Six scènes d’exécution':'Six execution scenes'} <small>{fr?'Artefact en anglais':'Artifact in English'}</small> ↗</a><a href={path('architecture/interactive')}>{fr?'Architecture interactive':'Interactive architecture'} <small>{fr?'Artefact en anglais':'Artifact in English'}</small> ↗</a><a href={path('architecture/drawing')}>{fr?'Le système en dessin':'The system illustrated'} <small>{fr?'Schéma en français':'Diagram in French'}</small> ↗</a><a href={url('/embeds/demonstration-bancaire.html')}>{fr?'Scénario bancaire':'Banking scenario'} <small>{fr?'Simulation fictive · français':'Fictional simulation · French'}</small> ↗</a></div><p class="section-note">{fr?'Pour distinguer ce qui est établi de ce qui reste ouvert :':'To distinguish what is established from what remains open:'} <a href={path('statut','status')}>{fr?'statut et limites':'status and limits'} →</a></p></section>

  <ExecutionBoundaryVideo locale={locale} />
  <section class="execution-lens" aria-labelledby="execution-lens-title">
    <div class="execution-lens-heading">
      <p class="eyebrow">{fr ? 'La frontière d’exécution' : 'The execution boundary'}</p>
      <h2 id="execution-lens-title">{fr ? 'Une décision avant l’effet.' : 'A decision before the effect.'}</h2>
      <p>{fr ? 'L’agent prépare une action. Le sas rend la décision visible avant qu’elle n’atteigne le système externe.' : 'The agent prepares an action. The boundary makes the decision visible before it reaches the external system.'}</p>
    </div>
    <div class="execution-flow" aria-label={fr ? 'Agent vers frontière d’exécution vers système externe, avec décisions autoriser, rejeter ou mettre en pause' : 'Agent to execution boundary to external system, with allow, deny or hold decisions'}>
      <span>{fr ? 'Agent IA' : 'AI agent'}</span><i aria-hidden="true">→</i><strong>{fr ? 'Frontière d’exécution' : 'Execution boundary'}<small>ALLOW · DENY · HOLD</small></strong><i aria-hidden="true">→</i><span>{fr ? 'Système externe' : 'External system'}<small>{fr ? 'Banque · API · service' : 'Bank · API · service'}</small></span>
    </div>
    <div class="execution-pillars">
      <article><h3>{fr ? 'Autorité située' : 'Situated authority'}</h3><p>{fr ? 'Relier l’action à son contexte, sa règle et la responsabilité qui l’autorise.' : 'Connect the action to its context, rule and accountable authority.'}</p></article>
      <article><h3>{fr ? 'HOLD quand l’état est inconnu' : 'HOLD when the state is unknown'}</h3><p>{fr ? 'Suspendre une reprise lorsque la réponse manque ou qu’un doublon reste possible.' : 'Pause a retry when the response is missing or a duplicate remains possible.'}</p></article>
      <article><h3>{fr ? 'Reçus de décision' : 'Decision receipts'}</h3><p>{fr ? 'Conserver ce qui a été décidé, sur quelles bases et ce qu’il reste à vérifier.' : 'Keep what was decided, on what basis and what still needs checking.'}</p></article>
    </div>
  </section>
  <section class="prototype-section" aria-labelledby="prototype-title">
    <div class="prototype-copy"><span class="pill">{fr ? 'À explorer · prototype' : 'Explore · prototype'}</span><h2 id="prototype-title">{fr ? 'Vous préférez essayer ?' : 'Would you rather try it?'}<br /><em>{fr ? 'Une tâche est prête.' : 'An example task is ready.'}</em></h2><p>{fr ? 'Proposez un créneau, simulez une réponse, puis mettez en pause. Vous pouvez découvrir le principe avec des données d’exemple, sans connecter votre agenda.' : 'Propose a slot, simulate a reply, then pause. Explore the idea with example data, without connecting your calendar.'}</p><ul class="check-list"><li>{fr ? 'Définir les limites d’une tâche' : 'Set a task’s limits'}</li><li>{fr ? 'Voir la prochaine proposition' : 'See the next proposal'}</li><li>{fr ? 'Mettre en pause et consulter l’activité' : 'Pause and review activity'}</li></ul><a class="btn btn-primary" href="https://mobile.tenirlabs.cc/discover">{fr ? 'Essayer avec la tâche d’exemple' : 'Try the example task'} <span aria-hidden="true">↗</span></a><p class="prototype-note">{fr ? 'Espace de démonstration distinct. Aucun vrai message envoyé.' : 'Separate demonstration space. No real messages sent.'}</p></div>
    <div class="phone-composition" aria-label={fr ? 'Aperçu illustratif du prototype, pas une interface interactive.' : 'Illustrative prototype preview, not an interactive interface.'}>
      <div class="phone"><div class="phone-status" aria-hidden="true"><span>9:41</span><span>● ▰</span></div><div class="phone-brand">⊣ <span>TENIR</span><small>{fr ? 'DÉLÉGATION' : 'DELEGATION'}</small></div><p class="phone-hello">{fr ? 'Moins à faire.' : 'Less to do.'}<br /><strong>{fr ? 'Gardez la main.' : 'Stay in control.'}</strong></p><div class="phone-task"><span class="phone-live"><span class="status-dot"></span>{fr ? 'En cours' : 'Active'}</span><h3>{fr ? 'Remplir les créneaux libres de demain' : 'Fill tomorrow’s free slots'}</h3><p>{fr ? '4 clients inclus · 09:00 — 17:00' : '4 included clients · 09:00 — 17:00'}</p><div class="phone-budget"><span>{fr ? 'Messages restants' : 'Messages left'}</span><strong>5 / 5</strong></div><div class="phone-progress"></div><div class="phone-faux-button">{fr ? 'Proposition simulée' : 'Simulated proposal'} <span aria-hidden="true">→</span></div></div><div class="phone-guard"><span aria-hidden="true">⊣</span><p>{fr ? 'Vos rendez-vous confirmés restent protégés.' : 'Your confirmed appointments stay protected.'}</p></div><div class="phone-bottom" aria-hidden="true"><span>⌂</span><span>☷</span><span>▦</span><span>◷</span></div></div><span class="floating-note"><span aria-hidden="true">↳</span> {fr ? 'Vous fixez le cadre.' : 'You set the frame.'}</span>
    </div>
  </section>

  <section class="home-offer-map" aria-labelledby="offer-map-title">
    <div class="home-offer-map-heading">
      <div><p class="eyebrow">{fr ? 'En un regard' : 'At a glance'}</p><h2 id="offer-map-title">{fr ? 'Faire examiner, explorer, comprendre.' : 'Engage, explore, understand.'}</h2></div>
      <p>{fr ? 'Distinguez ce que nous pouvons examiner ensemble, ce que vous pouvez essayer et ce qui relève encore de l’étude.' : 'Separate a scoped engagement, what you can try, and what remains framework or bounded software research.'}</p>
    </div>
    <div class="home-offer-grid">
      {entryPoints.map(item=><a class="home-offer-item" href={item.href}>
        <span class="role">{item.type}</span><h3>{item.title}</h3><p>{item.text}</p><span class="home-offer-link">{item.action} <span aria-hidden="true">→</span></span>
