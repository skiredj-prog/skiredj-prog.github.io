<script>
  function setupTabs(root: Element, tabSelector: string, panelSelector: string, next?: Element | null) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(tabSelector));
    const panels = Array.from(root.querySelectorAll<HTMLElement>(panelSelector));
    let active = 0;
    const show = (index: number, focus = false) => {
      active = index;
      tabs.forEach((tab,i) => { tab.setAttribute('aria-selected',String(i===index)); tab.tabIndex=i===index?0:-1; });
      panels.forEach((panel,i) => { panel.hidden=i!==index; });
      if (next) { next.toggleAttribute('disabled', index===tabs.length-1); }
      if(focus) tabs[index].focus();
    };
    tabs.forEach((tab,i) => {
      tab.addEventListener('click',()=>show(i));
      tab.addEventListener('keydown',event=>{
        let target = i;
        if(event.key==='ArrowRight') target=(i+1)%tabs.length;
        else if(event.key==='ArrowLeft') target=(i+tabs.length-1)%tabs.length;
        else if(event.key==='Home') target=0;
        else if(event.key==='End') target=tabs.length-1;
        else return;
        event.preventDefault(); show(target,true);
      });
    });
    next?.addEventListener('click',()=>{ if(active<tabs.length-1) show(active+1,true); });
  }
  document.querySelectorAll('[data-cycle]').forEach(root=>setupTabs(root,'[data-cycle-tab]','[data-cycle-panel]'));
</script>
