---
import '../styles/fonts.css';
import '../styles/pathway.css';
import {url, type Locale} from '../data/site';
interface Props { locale: Locale }
const {locale}=Astro.props;
const fr=locale==='fr';
const home=url(fr?'/':'/en/');
const other=url(fr?'/en/ai-readiness/':'/parcours-ia/');
const here=url(fr?'/parcours-ia/':'/en/ai-readiness/');
const canonical=new URL(here,Astro.site);
const t=fr?{
title:"Votre aperçu du parcours de maturité IA — TENIR Labs",
desc:"En dix questions, obtenez un aperçu graphique de votre position sur le parcours de maturité TENIR pour encadrer les actions confiées à vos agents IA.",
label:"APERÇU DU PARCOURS DE MATURITÉ · TENIR LABS",
tag:"L’IA avance. Vous gardez la main.",
head:"Obtenez un aperçu de votre parcours de maturité IA",
lead:"En 10 questions, situez votre organisation sur un parcours en six étapes : de la démonstration locale à une autorisation humaine indépendante.",
b1:"10 questions",b2:"5 minutes environ",b3:"Aperçu graphique",b4:"Sans compte",
start:"Voir mon parcours",more:"À quoi sert cet aperçu ?",
pitch:"Un aperçu graphique, pas un audit.",
pitchText:"Vos réponses indiquent une position probable, la prochaine étape à préparer et les preuves à renforcer. Elles ne vérifient ni vos systèmes ni vos preuves.",
steps:"Ce que vous allez recevoir",
s1:"Votre position actuelle",s1d:"Une étape indicative sur le parcours de maturité TENIR, avec les dimensions qui la soutiennent.",
s2:"Votre prochaine étape",s2d:"Le prochain passage à préparer, avec son gate et les questions à résoudre.",
s3:"Les preuves à renforcer",s3d:"Les éléments à documenter avant de présenter une capacité comme établie.",
usecaseLabel:"Usage examiné (facultatif)",usecasePlaceholder:"Ex. : agent de prise de rendez-vous",
privacy:"Les réponses restent dans votre navigateur. Aucun compte, aucun envoi automatique. Vous choisissez si vous partagez le rapport.",
progress:"QUESTIONNAIRE", back:"Précédent",next:"Suivant",finish:"Voir mon rapport",startOver:"Recommencer",
reportKicker:"APERÇU DE VOTRE PARCOURS DE MATURITÉ · AUTO-ÉVALUATION",
reportHeading:"Voici où vous vous situez aujourd’hui.",
reportIntro:"Cette position est une estimation déclarative à partir de vos réponses. Elle indique un point de départ et non une preuve de maturité.",
usageTitle:"Votre parcours d’usage",
usageNote:"Une lecture simple de la relation entre votre organisation et cet usage de l’IA — pas une note globale.",
maturityTitle:"Votre parcours de preuve en six étapes",
maturityNote:"Ce parcours indique ce qui doit être démontré avant de présenter une capacité comme établie.",
dimensions:"Six dimensions qui soutiennent votre parcours",
priorities:"Les trois actions à considérer",
recommend:"La prochaine étape avec TENIR Labs",
recommendBody:"Vous pouvez avancer seul avec ce rapport ou discuter d’un cas précis avec nous.",
share:"Partager mon rapport",copy:"Copier le rapport",download:"Télécharger",print:"Imprimer / PDF",copied:"Rapport copié",
contact:"Discuter de mon parcours",demo:"Essayer une démo",home:"Retour au site",limits:"Évaluation déclarative. Aucune vérification technique ou certification. Les recommandations sont indicatives ; un diagnostic peut les confirmer ou les nuancer.",
missing:"Non évalué",backToTop:"Revenir au début",
}:{
title:"Your AI maturity journey preview — TENIR Labs",
desc:"In ten questions, get a graphical view of your position on the TENIR maturity journey for governing AI-agent actions.",
label:"MATURITY JOURNEY PREVIEW · TENIR LABS",
tag:"AI takes action. You stay in control.",
head:"Get a graphical view of your AI maturity journey",
lead:"Ten questions place your organisation on a six-step journey, from local demonstration to independent human authorisation.",
b1:"10 questions",b2:"About 5 minutes",b3:"Graphical preview",b4:"No account",
start:"See my journey",more:"What is this preview for?",
pitch:"A graphical preview, not an audit.",
pitchText:"Your answers suggest a likely position, the next step to prepare and the evidence to strengthen. They do not verify your systems or evidence.",
steps:"What you'll take away",
s1:"Your current position",s1d:"An indicative TENIR maturity step, with the dimensions supporting it.",
s2:"Your next step",s2d:"The next passage to prepare, with its gate and open questions.",
s3:"Evidence to strengthen",s3d:"What to document before presenting a capability as established.",
usecaseLabel:"Usage examined (optional)",usecasePlaceholder:"E.g. appointment scheduling agent",
privacy:"Your answers stay in your browser. No account and no automatic submission. You choose whether to share the report.",
progress:"ASSESSMENT",back:"Previous",next:"Next",finish:"See my report",startOver:"Start again",
reportKicker:"MATURITY JOURNEY PREVIEW · SELF-ASSESSMENT",
reportHeading:"Here is where you appear to be today.",
reportIntro:"This is a self-reported estimate based on your answers. It indicates a starting point, not proof of maturity.",
usageTitle:"Your usage journey",
usageNote:"A simple view of the relationship between your organisation and this AI use case — not an organisation-wide score.",
maturityTitle:"Your six-step evidence journey",
maturityNote:"This journey shows what must be demonstrated before presenting a capability as established.",
dimensions:"Six dimensions supporting your journey",
priorities:"Three actions worth considering",
recommend:"Your next move with TENIR Labs",
recommendBody:"Use this report independently or talk to us about one specific scenario.",
share:"Share my report",copy:"Copy report",download:"Download",print:"Print / PDF",copied:"Report copied",
contact:"Discuss my pathway",demo:"Explore the demo",home:"Back to website",limits:"Self-reported assessment only. Not a technical verification or certification. Recommendations are indicative and can be confirmed or adjusted during a diagnostic.",
missing:"Not assessed",backToTop:"Back to start"
};
const demo=url(fr?'/portfolio/control-tower/':'/en/portfolio/control-tower/');
const contact=url(fr?'/contact/':'/en/contact/');
const navItems=fr?[
  {label:'Accueil',href:url('/')},
  {label:'Produits',href:url('/portfolio/products/')},
  {label:'Démos',href:url('/portfolio/demos/')},
  {label:'Crédibilité',href:url('/credibilite/')},
  {label:'Approche',href:url('/produits-et-services/')},
]:[
  {label:'Home',href:url('/en/')},
  {label:'Products',href:url('/en/portfolio/products/')},
  {label:'Demos',href:url('/en/portfolio/demos/')},
  {label:'Evidence',href:url('/en/credibility/')},
  {label:'Approach',href:url('/en/products-and-services/')},
];
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
  <meta name="theme-color" content="#071629"/>
  <title>{t.title}</title><meta name="description" content={t.desc}/>
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml"/>
  <link rel="canonical" href={canonical}/>
  <link rel="alternate" hreflang="fr" href={new URL(url('/parcours-ia/'),Astro.site)}/>
  <link rel="alternate" hreflang="en" href={new URL(url('/en/ai-readiness/'),Astro.site)}/>
  <meta property="og:title" content={t.title}/><meta property="og:description" content={t.desc}/>
</head>
<body data-pathway-app data-locale={locale} data-contact-href={contact} data-demo-href={demo} data-home-href={home}>
  <header class="pa-header">
    <a href={home} class="pa-brand" aria-label={fr?'TENIR Labs — accueil':'TENIR Labs — home'}>TENIR<span>·</span>Labs</a>
    <div class="pa-header-right">
      <nav class="pa-desktop-nav" aria-label={fr?'Navigation principale':'Main navigation'}>
        {navItems.map(item=><a href={item.href}>{item.label}</a>)}
      </nav>
      <span class="pa-header-label">{t.label}</span>
      <details class="pa-mobile-menu">
        <summary>{fr?'Menu':'Menu'} <span aria-hidden="true">☰</span></summary>
        <nav aria-label={fr?'Navigation principale':'Main navigation'}>
          {navItems.map(item=><a href={item.href}>{item.label}</a>)}
        </nav>
      </details>
      <a class="pa-lang" href={other} lang={fr?'en':'fr'}>{fr?'EN':'FR'}</a>
    </div>
  </header>
  <main id="pa-main">
    <section class="pa-intro" id="pa-intro" aria-labelledby="pa-title">
      <div class="pa-intro-inner">
        <span class="pa-eyebrow">{t.tag}</span>
        <h1 id="pa-title">{t.head}</h1>
        <div class="pa-usecase"><label for="pa-usecase">{t.usecaseLabel}</label><input id="pa-usecase" type="text" maxlength="140" placeholder={t.usecasePlaceholder}/><small>{fr?'Le résultat porte sur cet usage, pas sur toute votre organisation.':'The result concerns this use case, not your whole organisation.'}</small></div>
        <div class="pa-buttons"><button class="pa-button pa-primary" id="pa-start" type="button">{t.start} <span aria-hidden="true">→</span></button><a class="pa-button pa-outline" href="#pa-steps">{t.more} ↓</a></div>
        <div class="pa-facts"><span>{t.b1}</span><span>{t.b2}</span><span>{t.b3}</span><span>{t.b4}</span></div>
        <p class="pa-lead">{t.lead}</p>
        <p class="pa-privacy">{t.privacy}</p>
      </div>
    </section>
    <section class="pa-steps" id="pa-steps" aria-labelledby="pa-steps-title">
      <div class="pa-wrap">
        <div class="pa-heading"><span class="pa-eyebrow">{t.steps}</span><h2 id="pa-steps-title">{t.pitch}</h2><p>{t.pitchText}</p></div>
        <div class="pa-step-grid"><article><span>01</span><h3>{t.s1}</h3><p>{t.s1d}</p></article><article><span>02</span><h3>{t.s2}</h3><p>{t.s2d}</p></article><article><span>03</span><h3>{t.s3}</h3><p>{t.s3d}</p></article></div>
      </div>
    </section>
    <section class="pa-question" id="pa-question" aria-labelledby="pa-question-title" hidden>
      <div class="pa-question-inner">
        <div class="pa-progress"><span id="pa-progress-label" aria-live="polite"></span><span id="pa-count"></span></div>
        <div class="pa-track" aria-hidden="true"><div id="pa-progress-fill"></div></div>
        <span class="pa-qsection" id="pa-qsection"></span>
        <h2 id="pa-question-title" tabindex="-1"></h2>
        <div class="pa-options" id="pa-options" role="radiogroup" aria-labelledby="pa-question-title"></div>
        <div class="pa-qnav"><button class="pa-button pa-muted" type="button" id="pa-back">{t.back}</button><button class="pa-button pa-primary" type="button" id="pa-next" disabled>{t.next} →</button></div>
      </div>
    </section>
    <section class="pa-report" id="pa-report" aria-labelledby="pa-report-title" hidden>
      <div class="pa-report-hero"><div class="pa-wrap"><span class="pa-eyebrow">{t.reportKicker}</span><h1 id="pa-report-title" tabindex="-1">{t.reportHeading}</h1><p>{t.reportIntro}</p><div class="pa-report-summary" id="pa-report-summary" aria-live="polite"></div></div></div>
      <div class="pa-wrap pa-report-content">
        <section class="pa-usage" aria-labelledby="pa-usage-title"><div class="pa-maturity-heading"><h2 id="pa-usage-title">{t.usageTitle}</h2><p>{t.usageNote}</p></div><div class="pa-usage-meta" id="pa-usage-meta"></div><div class="pa-usage-map" id="pa-usage-map"></div></section>
        <section class="pa-maturity" aria-labelledby="pa-maturity-title"><div class="pa-maturity-heading"><h2 id="pa-maturity-title">{t.maturityTitle}</h2><p>{t.maturityNote}</p></div><div class="pa-maturity-map" id="pa-maturity-map"></div></section>
        <div class="pa-report-grid">
          <section class="pa-report-card" aria-labelledby="pa-dimensions-title"><h2 id="pa-dimensions-title">{t.dimensions}</h2><div id="pa-dimensions"></div></section>
          <section class="pa-report-card" aria-labelledby="pa-priorities-title"><h2 id="pa-priorities-title">{t.priorities}</h2><ol id="pa-priorities"></ol></section>
        </div>
        <section class="pa-offer" aria-labelledby="pa-offer-title"><span class="pa-eyebrow">{t.recommend}</span><h2 id="pa-offer-title"></h2><p id="pa-offer-description"></p><div class="pa-report-actions"><a class="pa-button pa-primary" id="pa-talk" href={contact}>{t.contact} ↗</a><a class="pa-button pa-outline" id="pa-learn" href={demo}>{t.demo} →</a></div><p class="pa-footnote">{t.recommendBody}</p></section>
        <div class="pa-report-toolbar"><button class="pa-button pa-muted" type="button" id="pa-download">{t.download} ↓</button><button class="pa-button pa-muted" type="button" id="pa-copy">{t.copy}</button><button class="pa-button pa-muted" type="button" id="pa-print">{t.print}</button><button class="pa-restart" type="button" id="pa-restart">{t.startOver}</button><span id="pa-feedback" role="status"></span></div>
        <p class="pa-limits">{t.limits}</p>
      </div>
    </section>
  </main>
  <footer class="pa-footer"><a href={home}>{t.home}</a><span>© 2026 TENIR Labs · Casablanca</span><a href="mailto:skiredj@tenirlabs.cc">skiredj@tenirlabs.cc</a></footer>
  <script src={url('/pathway.js')} defer></script>
</body>
</html>
