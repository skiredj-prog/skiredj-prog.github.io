---
import '../styles/marketing-home.css';
import { url, type Locale } from '../data/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const fr = locale === 'fr';
const path = (p: string) => url((fr ? '/' : '/en/') + p + '/');
const contact = path('contact') + '?sujet=diagnostic';
const pathway = url(fr ? '/parcours-ia/' : '/en/ai-readiness/');
const demo = path('portfolio/control-tower');
const whyNow = path(fr ? 'pourquoi-maintenant' : 'why-now');
const t = fr ? {
  eyebrow: 'TENIR LABS · DES AGENTS IA SOUS CONTRÔLE',
  headlineStart: 'L’IA agit.',
  headlineEnd: 'Vous gardez la main.',
  tagline: 'Confiez des tâches à l’IA. Pas les clés de votre entreprise.',
  summary: 'Vos agents IA peuvent déclencher des paiements, modifier des dossiers ou engager votre entreprise. TENIR Labs vous aide à fixer leurs limites, repérer les actions à risque et gérer les situations où personne ne sait exactement ce qui s’est passé.',
  primary: 'Comprendre pourquoi maintenant',
  secondary: 'Voir un cas concret',
  heroNote: 'Une question de marché · des situations reconnaissables · une première lecture',
  tension: 'L’EXEMPLE QUI CHANGE TOUT',
  tensionTitle: 'Et si votre IA payait deux fois ?',
  tensionBody: 'Un agent déclenche un paiement. La confirmation disparaît. L’IA pense devoir recommencer. Mais le premier paiement a peut-être déjà eu lieu. Comment éviter une deuxième opération à l’aveugle ?',
  without: 'Sans frontière claire',
  withoutHead: 'Relancer à l’aveugle.',
  withoutBody: 'Une réponse absente est prise pour un échec. La même opération peut partir deux fois.',
  with: 'Avec une frontière gouvernée',
  withHead: 'Savoir quand s’arrêter.',
  withBody: 'Le scénario de gouvernance passe en HOLD et exige un rapprochement avant une nouvelle tentative.',
  fictional: 'Scénario illustratif · pas de transaction réelle',
  caseLink: 'Explorer les cas réels et simulés',
  bankLink: 'Voir le scénario bancaire · français',
  promise: 'DES SOLUTIONS, PAS UN LABYRINTHE',
  solutions: 'Trois façons de reprendre le contrôle.',
  solutionsSub: 'Commencez par une décision critique. Nous adaptons ensuite l’approche à vos systèmes et à votre niveau de maturité.',
  choose: 'Découvrir',
  stepsEyebrow: 'UN PARCOURS SIMPLE',
  stepsTitle: 'Avant. Pendant. Après.',
  before: 'Anticiper les angles morts.',
  during: 'Gouverner le point d’action.',
  after: 'Retrouver les faits et les preuves.',
  demoEyebrow: 'À VOUS DE JOUER',
  demoTitle: 'Moins de slides. Plus de scénarios.',
  demoSub: 'Explorez les décisions HOLD, les requêtes en double et les résultats inconnus dans une simulation interactive. Aucune connexion à un système réel.',
  demoLaunch: 'Ouvrir la démo en plein écran',
  demoAll: 'Toutes les expériences',
  trust: 'LA CRÉDIBILITÉ, EN ACCÈS LIBRE',
  trustTitle: 'Une idée ambitieuse. Du code que l’on peut examiner.',
  trustSub: 'La démarche s’appuie sur des logiciels ouverts, des publications et des tests contextualisés. Les périmètres et limites sont documentés.',
  source: 'Code source public',
  papers: 'Publications et recherche',
  status: 'Statut et périmètres',
  credibility: 'Parcours Crédibilité · 5.7.0',
  closeTitle: 'Vous savez ce que votre IA peut faire. Découvrez par où commencer.',
  closeSub: 'Dix questions pour situer votre point de départ sur un parcours de maturité, repérer la prochaine vérification utile et décider si un accompagnement est nécessaire.',
  closePrimary: 'Voir mon aperçu de maturité',
  closeSecondary: 'Écrire directement',
  smallPrint: 'Diagnostic sur devis · logiciels et prototypes à maturité distincte',
} : {
  eyebrow: 'TENIR LABS · AI AGENTS UNDER CONTROL',
  headlineStart: 'AI takes action.',
  headlineEnd: 'You stay in control.',
  tagline: 'Give AI the work. Not the keys to your business.',
  summary: 'AI agents can initiate payments, update records and make commitments on your behalf. TENIR Labs helps you set the limits, spot risky actions and handle those moments when no one knows exactly what happened.',
  primary: 'Understand why now',
  secondary: 'See one concrete case',
  heroNote: 'A market question · recognizable situations · a first explanation',
  tension: 'THE EXAMPLE THAT CHANGES EVERYTHING',
  tensionTitle: 'What if your AI paid twice?',
  tensionBody: 'An agent initiates a payment. The confirmation disappears. The AI thinks it should try again. But the first payment might already have gone through. How do you avoid a second payment in the dark?',
  without: 'Without a clear boundary',
  withoutHead: 'Retry in the dark.',
  withoutBody: 'A missing response is mistaken for failure. The same operation may be dispatched twice.',
  with: 'With a governed boundary',
  withHead: 'Know when to stop.',
  withBody: 'The governance scenario enters HOLD and requires reconciliation before another attempt.',
  fictional: 'Illustrative scenario · no live transaction',
  caseLink: 'Explore real and simulated cases',
  bankLink: 'View the banking scenario · French',
  promise: 'SOLUTIONS, NOT A MAZE',
  solutions: 'Three ways to take back control.',
  solutionsSub: 'Start with one consequential decision. Then match the approach to your systems and maturity.',
  choose: 'Explore',
  stepsEyebrow: 'ONE CLEAR JOURNEY',
  stepsTitle: 'Before. During. After.',
  before: 'Reveal the blind spots.',
  during: 'Govern the point of action.',
  after: 'Recover the facts and evidence.',
  demoEyebrow: 'TRY IT YOURSELF',
  demoTitle: 'Fewer slides. More scenarios.',
  demoSub: 'Explore HOLD decisions, duplicate requests and unknown outcomes in an interactive simulation. No connection to a live external system.',
  demoLaunch: 'Open the full demo',
  demoAll: 'Browse all experiences',
  trust: 'CREDIBILITY IN THE OPEN',
  trustTitle: 'An ambitious idea. Code you can inspect.',
  trustSub: 'Our approach is grounded in open software, published research and scoped tests. Boundaries and limitations are documented.',
  source: 'Open-source code',
  papers: 'Research and publications',
  status: 'Status and scope',
  credibility: 'Credibility Journey · 5.7.0',
  closeTitle: 'You know what AI can do. Find out where to begin.',
  closeSub: 'Ten questions to place your starting point on a maturity journey, identify the next useful check and decide whether outside help is needed.',
  closePrimary: 'See my maturity preview',
  closeSecondary: 'Email us',
  smallPrint: 'Diagnostic quoted by scope · software and prototypes at different maturity levels',
};
const cards = fr ? [
 {tag:'SERVICE', name:'Execution Boundary Diagnostic', headline:'Découvrez votre point de non-retour.', desc:'Une analyse ciblée d’un flux critique, de ses responsabilités et des angles morts entre autorisation et conséquence.', href:path('diagnostic-execution'),action:'Explorer le diagnostic',mark:'01'},
 {tag:'MÉTHODES', name:'REG Prevent · Prepare',headline:'Transformez les politiques en décisions concrètes.',desc:'Passez des exigences aux contrôles candidats, puis des systèmes aux preuves disponibles. Deux approches, indépendantes ou complémentaires.',href:path('produits-et-services'),action:'Explorer les méthodes',mark:'02'},
 {tag:'SOFTWARE · BÊTA',name:'TENIR-Gov',headline:'Placez un contrôle entre l’intention et l’impact.',desc:'Une couche de gouvernance de l’exécution pour les actions intégrées, avec décisions bornées, HOLD et traçabilité. Logiciel open source.',href:path('portfolio/gov'),action:'Découvrir le logiciel',mark:'03'},
] : [
 {tag:'SERVICE',name:'Execution Boundary Diagnostic',headline:'Find your point of no return.',desc:'A focused review of one critical flow, its owners, and the blind spots between authorization and consequence.',href:path('diagnostic-execution'),action:'Explore the diagnostic',mark:'01'},
 {tag:'METHODS',name:'REG Prevent · Prepare',headline:'Turn policies into operational decisions.',desc:'Move from requirements to candidate controls, then from systems to available evidence. Independent or complementary approaches.',href:path('products-and-services'),action:'Explore the methods',mark:'02'},
 {tag:'SOFTWARE · BETA',name:'TENIR-Gov',headline:'Put control between intention and impact.',desc:'Execution governance for integrated agent actions, with bounded verdicts, HOLD and traceability. Open-source software.',href:path('portfolio/gov'),action:'Explore the software',mark:'03'},
];
---
<div class="market-root">
  <section class="ml-hero" aria-labelledby="market-heading">
    <div class="ml-wrap">
      <p class="ml-eyebrow"><span class="ml-dot" aria-hidden="true"></span>{t.eyebrow}</p>
      <h1 id="market-heading" class="ml-headline"><span>{t.headlineStart}</span><em>{t.headlineEnd}</em></h1>
      <p class="ml-hero-tagline">{t.tagline}</p>
      <div class="ml-actions" aria-label={fr ? 'Choisir votre prochaine étape' : 'Choose your next step'}>
        <a class="ml-btn ml-btn-primary" href={whyNow}>{t.primary} <span aria-hidden="true">↗</span></a>
        <a class="ml-btn ml-btn-outline" href="#comprendre">{t.secondary} <span aria-hidden="true">→</span></a>
      </div>
      <p class="ml-hero-foot">{t.heroNote}</p>
      <p class="ml-hero-body">{t.summary}</p>
    </div>
  </section>

  <section class="ml-why-now" aria-labelledby="ml-why-now-title">
    <div class="ml-wrap ml-why-now-grid">
      <div><span class="ml-kicker">{fr ? 'POURQUOI MAINTENANT' : 'WHY NOW'}</span><h2 id="ml-why-now-title">{fr ? 'L’IA ne se contente plus de répondre. Elle peut faire des choses à votre place.' : 'AI no longer only answers. It can do things on your behalf.'}</h2><p>{fr ? 'C’est pratique — jusqu’au jour où elle envoie le mauvais paiement, modifie le mauvais dossier ou répond au client sans que personne ne sache exactement ce qui s’est passé.' : 'That is useful — until it sends the wrong payment, changes the wrong record or replies to a customer and no one knows exactly what happened.'}</p><a class="ml-story-link" href={whyNow}>{fr ? 'Voir les situations concrètes' : 'See the concrete situations'} →</a></div>
      <div class="ml-why-now-list"><article><b>01</b><span>{fr ? 'Un paiement est lancé. La confirmation n’arrive pas. Faut-il recommencer ?' : 'A payment is sent. The confirmation never arrives. Should it be tried again?'}</span></article><article><b>02</b><span>{fr ? 'Un dossier est modifié automatiquement. Qui vérifie que c’est bien le bon ?' : 'A record is changed automatically. Who checks that it is the right one?'}</span></article><article><b>03</b><span>{fr ? 'Une réponse est envoyée au nom de l’entreprise. Qui la relit avant qu’elle parte ?' : 'A reply is sent in the company’s name. Who reads it before it goes out?'}</span></article></div>
    </div>
  </section>

  <section class="ml-threat" id="comprendre" aria-labelledby="ml-threat-title">
    <div class="ml-wrap ml-threat-grid">
      <div class="ml-story">
        <span class="ml-kicker">{t.tension}</span>
        <h2 id="ml-threat-title">{t.tensionTitle}</h2>
        <p>{t.tensionBody}</p>
        <span class="ml-fiction">{t.fictional}</span><a class="ml-story-link" href={path(fr?'cas':'cases')}>{t.caseLink} →</a>
      </div>
      <div class="ml-outcomes">
        <div class="ml-outcome ml-risk"><span class="ml-mini-label">{t.without}</span><strong>{t.withoutHead}</strong><p>{t.withoutBody}</p><span class="ml-indicator">RETRY? <span aria-hidden="true">↻</span></span></div>
        <div class="ml-outcome ml-safe"><span class="ml-mini-label">{t.with}</span><strong>{t.withHead}</strong><p>{t.withBody}</p><span class="ml-indicator">HOLD <span aria-hidden="true">●</span></span></div>
      </div>
    </div>
  </section>

  <section class="ml-offerings ml-section" aria-labelledby="ml-offerings-title" id="demarche">
    <div class="ml-wrap">
      <div class="ml-section-top"><span class="ml-kicker">{t.promise}</span><h2 id="ml-offerings-title">{t.solutions}</h2><p>{t.solutionsSub}</p></div>
      <div class="ml-cards">
        {cards.map(card => <a class="ml-card" href={card.href}>
          <div class="ml-card-top"><span class="ml-card-number">{card.mark}</span><span class="ml-card-type">{card.tag}</span></div>
          <h3>{card.name}</h3><strong>{card.headline}</strong><p>{card.desc}</p><span class="ml-card-action">{card.action} <span aria-hidden="true">↗</span></span>
        </a>)}
      </div>
      <div class="ml-short-journey home-lifecycle">
        <span class="ml-kicker">{t.stepsEyebrow}</span><h3>{t.stepsTitle}</h3>
        <div class="lifecycle-flow">
          <p><span>01</span>{t.before}</p>
          <p><span>02</span>{t.during}</p>
          <p><span>03</span>{t.after}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="ml-demo ml-section" aria-labelledby="ml-demo-title" id="essayer">
    <div class="ml-wrap">
      <div class="ml-demo-copy">
        <div class="ml-section-top"><span class="ml-kicker">{t.demoEyebrow}</span><h2 id="ml-demo-title">{t.demoTitle}</h2><p>{t.demoSub}</p></div>
        <div class="ml-demo-actions"><a class="ml-btn ml-btn-primary" href={demo}>{t.demoLaunch} <span aria-hidden="true">↗</span></a><a class="ml-text-link" href={path('portfolio/demos')}>{t.demoAll} →</a><a class="ml-text-link" href={url('/embeds/demonstration-bancaire.html')}>{t.bankLink} →</a></div>
        <p class="ml-demo-disclaimer">{t.fictional}</p>
      </div>
      <div class="ml-demo-panel">
        <div class="ml-panel-bar"><span aria-hidden="true">● ● ●</span><span>CONTROL TOWER / SIMULATION</span></div>
        <iframe src={url('/embeds/reg-autonomy-control-tower-v1.0.html')} loading="lazy" title={fr ? 'Control Tower — simulation de gouvernance avec données fictives' : 'Control Tower — fictional execution-governance simulation'}></iframe>
      </div>
    </div>
  </section>

  <section class="ml-trust ml-section" aria-labelledby="ml-trust-title">
    <div class="ml-wrap">
      <div class="ml-section-top"><span class="ml-kicker">{t.trust}</span><h2 id="ml-trust-title">{t.trustTitle}</h2><p>{t.trustSub}</p></div>
      <div class="ml-trust-links">
        <a href="https://github.com/skiredj-prog/tenir_governance" rel="noopener" target="_blank"><span class="ml-trust-icon" aria-hidden="true">⌘</span>{t.source}<span aria-hidden="true">↗</span></a>
        <a href={path('publications')}><span class="ml-trust-icon" aria-hidden="true">§</span>{t.papers}<span aria-hidden="true">↗</span></a>
        <a href={path(fr?'credibilite':'credibility')}><span class="ml-trust-icon" aria-hidden="true">◎</span>{t.credibility}<span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="ml-closing" aria-labelledby="ml-closing-title">
    <div class="ml-wrap"><span class="ml-kicker">TENIR LABS</span><h2 id="ml-closing-title">{t.closeTitle}</h2><p>{t.closeSub}</p>
      <div class="ml-actions"><a class="ml-btn ml-btn-primary" href={pathway}>{t.closePrimary} ↗</a><a class="ml-btn ml-btn-outline" href="mailto:skiredj@tenirlabs.cc">{t.closeSecondary} →</a></div>
      <p class="ml-hero-foot">{t.smallPrint}</p>
    </div>
  </section>
</div>
